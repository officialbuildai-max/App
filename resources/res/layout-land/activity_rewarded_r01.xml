<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_layout"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/ad_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/ad_volume"
        android:background="@drawable/hisavana_hollow_round"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="52dp"
        android:src="@drawable/hisavana_volume_close"
        android:layout_marginStart="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/ad_close_container"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginTop="47dp"
        android:paddingStart="@dimen/dp_6"
        android:paddingEnd="@dimen/dp_5"
        android:layout_marginEnd="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.cloud.hisavana.sdk.common.util.HSChronometer
            android:textSize="12sp"
            android:textColor="@color/hisavana_ad_color_787878"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/ad_chronometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format=""/>
        <ImageView
            android:id="@+id/ad_close"
            android:background="@drawable/hisavana_round_gray_bg"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/hs_ad_cancel"
            android:layout_marginStart="@dimen/dp_5"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ad_float_container"
        android:background="@color/white"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <com.cloud.sdk.commonutil.widget.TranCircleImageView
            android:id="@+id/ad_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            app:bottomLeftRadiusYL="4dp"
            app:bottomRightRadiusYL="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:topLeftRadiusYL="4dp"
            app:topRightRadiusYL="4dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ffffff"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/ad_btn"
            android:background="@drawable/ssp_bg_0052e2_4_4_4_4"
            android:paddingLeft="8dp"
            android:paddingTop="7dp"
            android:paddingRight="8dp"
            android:paddingBottom="7dp"
            android:layout_width="120dp"
            android:layout_height="40dp"
            android:text=""
            android:lines="1"
            android:layout_weight="1"
            android:layout_marginEnd="16dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="7dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.cloud.hisavana.sdk.api.view.StoreMarkView
            android:id="@+id/ps_mark_view"
            android:layout_width="wrap_content"
            android:layout_height="10dp"
            android:layout_marginEnd="18dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ad_btn"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            app:layout_constraintBottom_toBottomOf="@+id/ad_icon"
            app:layout_constraintEnd_toStartOf="@+id/ps_mark_view"
            app:layout_constraintStart_toEndOf="@+id/ad_icon"
            app:layout_constraintTop_toTopOf="@+id/ad_icon">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/black"
                android:ellipsize="end"
                android:id="@+id/ad_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:lines="1"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/hisavana_ad_color_787878"
                android:ellipsize="end"
                android:gravity="start"
                android:id="@+id/ad_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text=""
                android:maxLines="1"
                android:lineSpacingExtra="4dp"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.cloud.hisavana.sdk.api.view.AdDisclaimerView
        android:id="@+id/ad_disclaimer_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="@dimen/ad_disclaimer_height"
        android:layout_marginStart="120dp"
        android:layout_marginEnd="120dp"
        app:layout_constraintBottom_toTopOf="@+id/ad_float_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <include
        android:id="@+id/ad_flag"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toTopOf="@+id/ad_float_container"
        app:layout_constraintStart_toStartOf="parent"
        layout="@layout/hs_include_ad_flag"/>
</androidx.constraintlayout.widget.ConstraintLayout>
