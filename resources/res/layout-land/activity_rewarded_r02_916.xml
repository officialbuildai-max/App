<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_layout"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/ad_container"
        android:layout_width="206dp"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ad_float_container"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/ad_volume"
        android:background="@drawable/ad_99000000_12_12_12_12"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toStartOf="@+id/ad_close"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="16dp"/>
    <ImageView
        android:id="@+id/ad_close"
        android:background="@drawable/ad_99000000_12_12_12_12"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="48dp"
        android:src="@drawable/hs_ad_close2"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ad_float_container"
        android:background="#ffffff"
        android:layout_width="328dp"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.cloud.sdk.commonutil.widget.TranCustomRoundAngleView
            android:id="@+id/view_reward_tips_bg"
            android:background="@drawable/ad_ssp_r02_reward_tips_bg"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            app:layout_constraintBottom_toBottomOf="parent"/>
        <com.cloud.sdk.commonutil.widget.TranCustomRoundAngleView
            android:id="@+id/view_reward_tips_gift"
            android:background="@drawable/ad_ssp_r02_reward_tips_gift"
            android:layout_width="100dp"
            android:layout_height="48dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/view_reward_tips_bg"
            app:topLeftRadius="8dp"
            app:topRightRadius="8dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#914d00"
            android:ellipsize="end"
            android:id="@+id/tv_reward_tips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="12dp"
            app:layout_constrainedHeight="true"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/view_reward_tips_bg"
            app:layout_constraintEnd_toStartOf="@+id/view_reward_tips_gift"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/view_reward_tips_bg"/>
        <com.cloud.sdk.commonutil.widget.TranCircleImageView
            android:id="@+id/ad_icon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="112dp"
            android:layout_marginStart="32dp"
            app:borderColorYL="#1a000000"
            app:borderSpaceYL="0.5dp"
            app:borderWidthYL="0.5dp"
            app:bottomLeftRadiusYL="4dp"
            app:bottomRightRadiusYL="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:topLeftRadiusYL="4dp"
            app:topRightRadiusYL="4dp"/>
        <TextView
            android:textSize="18sp"
            android:textColor="#000000"
            android:ellipsize="end"
            android:id="@+id/ad_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="8dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="@+id/ad_btn"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/ad_icon"
            app:layout_constraintTop_toTopOf="@+id/ad_icon"/>
        <ImageView
            android:id="@+id/iv_download_app_score"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/hs_ad_score"
            android:layout_marginStart="9dp"
            app:layout_constraintBottom_toBottomOf="@+id/ad_description"
            app:layout_constraintStart_toEndOf="@+id/ad_icon"
            app:layout_constraintTop_toTopOf="@+id/ad_description"/>
        <TextView
            android:textSize="14sp"
            android:ellipsize="end"
            android:id="@+id/ad_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:maxLines="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="8dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/ad_icon"
            app:layout_constraintEnd_toEndOf="@+id/ad_btn"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/iv_download_app_score"
            app:layout_goneMarginStart="8dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#ffffff"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/ad_btn"
            android:background="@drawable/ssp_bg_0052e2_4_4_4_4"
            android:layout_width="264dp"
            android:layout_height="40dp"
            android:layout_marginTop="24dp"
            android:text="Download"
            android:maxLines="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ad_icon"/>
        <com.cloud.hisavana.sdk.api.view.StoreMarkView
            android:id="@+id/ps_mark_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ad_btn"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/ad_close_container"
        android:background="@drawable/ad_99000000_12_12_12_12"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginTop="48dp"
        android:paddingStart="8dp"
        android:paddingEnd="12dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_reward_gift"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ad_reward_time_gift"/>
        <com.cloud.hisavana.sdk.common.util.HSChronometer
            android:textSize="12sp"
            android:textColor="@color/ad_text_color"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/ad_chronometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format="Reward after 5 seconds"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <include
        android:id="@+id/ad_flag"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        layout="@layout/hs_include_ad_flag_i01"/>
    <com.cloud.hisavana.sdk.api.view.AdDisclaimerView
        android:gravity="center"
        android:id="@+id/ad_disclaimer_view"
        android:layout_width="0dp"
        android:layout_height="@dimen/ad_disclaimer_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ad_float_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
