<?xml version="1.0" encoding="utf-8"?>
<com.noober.background.view.BLConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="166dp">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivCover"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearance="@style/roundStyle_4"/>
    <com.noober.background.view.BLView
        android:id="@+id/vCoverGra"
        android:layout_width="0dp"
        android:layout_height="42dp"
        app:bl_corners_bottomRadius="4dp"
        app:bl_gradient_angle="270"
        app:bl_gradient_endColor="@color/black"
        app:bl_gradient_startColor="@color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.noober.background.view.BLView
        android:id="@+id/vCoverStroke"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:bl_corners_radius="4dp"
        app:bl_stroke_color="@color/white_10"
        app:bl_stroke_width="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivVideoPlay"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="9dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivCover"
        app:layout_constraintEnd_toEndOf="@+id/ivCover"
        app:layout_constraintStart_toStartOf="@+id/ivCover"
        app:layout_constraintTop_toTopOf="@+id/ivCover"
        app:srcCompat="@mipmap/ic_room_post_play"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivRoomCover"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginBottom="8dp"
        android:scaleType="centerCrop"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:shapeAppearance="@style/roundStyle_4"/>
    <com.tn.lib.widget.TnTextView
        android:textSize="11sp"
        android:textColor="@color/white_60"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/tvRoomTitle"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:maxLines="2"
        android:includeFontPadding="false"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivRoomCover"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ivRoomCover"
        app:layout_constraintTop_toTopOf="@+id/ivRoomCover"
        app:lineHeight="12dp"
        style="@style/style_regular_text"/>
    <View
        android:id="@+id/vRoomInfo"
        android:layout_width="0dp"
        android:layout_height="42dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</com.noober.background.view.BLConstraintLayout>
