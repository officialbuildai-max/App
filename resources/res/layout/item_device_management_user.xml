<?xml version="1.0" encoding="utf-8"?>
<com.noober.background.view.BLConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:layout_marginTop="12dp"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    app:bl_corners_radius="8dp"
    app:bl_solid_color="@color/white_6">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/userAvatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearance="@style/circle_style"/>
    <com.noober.background.view.BLView
        android:id="@+id/userAvatarBorder"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:bl_corners_radius="24dp"
        app:bl_stroke_color="@color/white_40"
        app:bl_stroke_width="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/userAvatar"
        app:layout_constraintEnd_toEndOf="@+id/userAvatar"
        app:layout_constraintStart_toStartOf="@+id/userAvatar"
        app:layout_constraintTop_toTopOf="@+id/userAvatar"/>
    <com.tn.lib.widget.TnTextView
        android:textSize="16sp"
        android:textColor="@color/white_100"
        android:ellipsize="end"
        android:id="@+id/userName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/validUntil"
        app:layout_constraintEnd_toStartOf="@+id/memberBadge"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/userAvatar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/style_import_text"/>
    <com.noober.background.view.BLTextView
        android:textSize="12sp"
        android:gravity="center"
        android:id="@+id/memberBadge"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:paddingStart="14dp"
        android:paddingEnd="6dp"
        android:layout_marginStart="16dp"
        app:bl_corners_radius="4dp"
        app:bl_selected_solid_color="@color/device_management_pro_badge_background"
        app:bl_selected_textColor="@color/yellow_dark_10"
        app:bl_unSelected_solid_color="@color/device_management_basic_badge_background"
        app:bl_unSelected_textColor="@color/device_management_basic_badge_text"
        app:layout_constraintBottom_toBottomOf="@+id/userName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/userName"
        app:layout_constraintTop_toTopOf="@+id/userName"
        style="@style/style_import_text"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/memberBadgeIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="-12dp"
        app:layout_constraintBottom_toBottomOf="@+id/memberBadge"
        app:layout_constraintEnd_toStartOf="@+id/memberBadge"
        app:layout_constraintTop_toTopOf="@+id/memberBadge"/>
    <com.tn.lib.widget.TnTextView
        android:textSize="12sp"
        android:textColor="@color/white_60"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/validUntil"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:textAlignment="viewStart"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/userName"
        app:layout_constraintTop_toBottomOf="@+id/userName"
        style="@style/style_regular_text"/>
</com.noober.background.view.BLConstraintLayout>
