<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_root"
    android:layout_width="64dp"
    android:layout_height="wrap_content">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_cover_bg"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:scaleType="centerCrop"
        android:alpha="0.16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearance="@style/roundStyle_8"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_cover"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearance="@style/corner_style_6"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="9sp"
        android:textColor="@color/white_80"
        android:id="@+id/tv_members"
        android:background="@drawable/bg_room_join_corner_r_4"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:layout_width="0dp"
        android:layout_marginTop="2dp"
        android:includeFontPadding="false"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:layout_marginStart="2dp"
        app:drawableStartCompat="@drawable/ic_room_home_member"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/style_medium_text"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="10sp"
        android:textColor="@color/white_80"
        android:ellipsize="end"
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="@+id/iv_cover"
        app:layout_constraintTop_toBottomOf="@+id/iv_cover"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/style_medium_small_text"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="13sp"
        android:textColor="@color/white_60"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tv_tag"
        android:visibility="gone"
        android:layout_width="0dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:textAlignment="viewStart"
        app:layout_constraintBottom_toBottomOf="@+id/v_join"
        app:layout_constraintEnd_toStartOf="@+id/v_join"
        app:layout_constraintStart_toStartOf="@+id/iv_cover"
        app:layout_constraintTop_toTopOf="@+id/v_join"
        style="@style/style_regular_text"/>
    <View
        android:background="@drawable/bg_room_join_corner_r_12"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginBottom="-3dp"
        android:layout_marginEnd="-3dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_cover"
        app:layout_constraintEnd_toEndOf="parent"/>
    <com.tn.lib.view.RoomJoinAnimationView
        android:id="@+id/v_join"
        android:layout_width="18dp"
        android:layout_height="18dp"
        app:jv_style="image"
        app:layout_constraintBottom_toBottomOf="@+id/iv_cover"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
