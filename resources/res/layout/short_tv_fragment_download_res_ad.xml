<?xml version="1.0" encoding="utf-8"?>
<com.noober.background.view.BLConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:bl_corners_topLeftRadius="8dp"
    app:bl_corners_topRightRadius="8dp"
    app:bl_solid_color="@color/short_tv_gray_20">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_close"
        android:padding="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@mipmap/short_tv_ic_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.noober.background.view.BLView
        android:id="@+id/v_bg"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="64dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="64dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="64dp"
        app:bl_corners_radius="8dp"
        app:bl_stroke_color="@color/short_tv_white_20"
        app:bl_stroke_width="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_ad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/v_bg"
        app:layout_constraintStart_toStartOf="@+id/v_bg"
        app:layout_constraintTop_toTopOf="@+id/v_bg"
        app:srcCompat="@mipmap/short_tv_ic_download_ad"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/short_tv_white"
        android:ellipsize="end"
        android:id="@+id/tv_watch"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:text="@string/short_tv_download_watch_ad_tips"
        android:maxLines="2"
        android:layout_marginStart="7dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_ep"
        app:layout_constraintEnd_toStartOf="@+id/tv_unlock"
        app:layout_constraintStart_toEndOf="@+id/iv_ad"
        app:layout_constraintTop_toTopOf="@+id/v_bg"
        style="@style/short_tv_style_medium_text"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/short_tv_main"
        android:id="@+id/tv_ep"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/v_bg"
        app:layout_constraintEnd_toStartOf="@+id/tv_unlock"
        app:layout_constraintStart_toEndOf="@+id/iv_ad"
        app:layout_constraintStart_toStartOf="@+id/tv_watch"
        app:layout_constraintTop_toBottomOf="@+id/tv_watch"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16sp"
        android:textColor="@color/short_tv_white"
        android:gravity="center"
        android:id="@+id/tv_unlock"
        android:background="@drawable/short_tv_btn_selector"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:text="@string/short_tv_unlock"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/v_bg"
        app:layout_constraintEnd_toEndOf="@+id/v_bg"
        app:layout_constraintTop_toTopOf="@+id/v_bg"
        style="@style/short_tv_style_medium_text"/>
</com.noober.background.view.BLConstraintLayout>
