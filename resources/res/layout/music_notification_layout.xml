<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="16dp"
        android:layout_height="26dp"
        android:layout_marginTop="11dp"
        android:src="@mipmap/ic_launcher"
        android:layout_marginStart="16dp"/>
    <TextView
        android:textSize="12sp"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/base_app_name"
        android:layout_alignTop="@+id/ivLogo"
        android:layout_alignBottom="@+id/ivLogo"
        android:layout_marginStart="10dp"
        android:layout_toEndOf="@+id/ivLogo"
        style="@style/TextAppearance.Compat.Notification"/>
    <ImageView
        android:id="@+id/ivClose"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="16dp"
        android:src="@mipmap/player_music_notification_close"
        android:layout_marginEnd="16dp"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:id="@+id/lineView"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:layout_below="@+id/ivLogo"/>
    <ImageView
        android:id="@+id/ivCover"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginBottom="16dp"
        android:scaleType="centerInside"
        android:layout_below="@+id/lineView"
        android:layout_alignStart="@+id/ivLogo"/>
    <ImageView
        android:id="@+id/ivPlayPause"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_alignTop="@+id/ivCover"
        android:layout_centerVertical="true"
        android:layout_marginEnd="16dp"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_01"
        android:ellipsize="end"
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_alignTop="@+id/ivCover"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_toStartOf="@+id/ivPlayPause"
        android:layout_toEndOf="@+id/ivCover"/>
    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="4dp"
        android:max="100"
        android:progress="30"
        android:progressDrawable="@drawable/download_progress_drawable"
        android:layout_below="@+id/tvTitle"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_toStartOf="@+id/ivPlayPause"
        android:layout_toEndOf="@+id/ivCover"
        style="?android:attr/progressBarStyleHorizontal"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/text_02"
        android:id="@+id/tvTimeConsuming"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@+id/ivCover"
        android:layout_marginStart="12dp"
        android:layout_toEndOf="@+id/ivCover"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/text_02"
        android:id="@+id/tvDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@+id/ivCover"
        android:layout_marginEnd="12dp"
        android:layout_toStartOf="@+id/ivPlayPause"/>
</RelativeLayout>
