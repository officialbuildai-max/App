<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.noober.background.view.BLConstraintLayout
        android:layout_gravity="center"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:bl_corners_radius="16dp"
        app:bl_solid_color="@color/kids_color_dialog_bg">
        <com.tn.lib.widget.TnTextView
            android:textSize="16sp"
            android:textColor="@color/base_color_white"
            android:gravity="center"
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/kids_delete_confirm_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@font/mulish_bold"/>
        <com.tn.lib.widget.TnTextView
            android:textSize="12sp"
            android:textColor="@color/base_white_80_p"
            android:gravity="center"
            android:id="@+id/tvDesc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/kids_delete_confirm_desc"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle"
            style="@font/mulish_regular"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvDesc">
            <com.noober.background.view.BLTextView
                android:textSize="14sp"
                android:textColor="@color/base_color_white"
                android:gravity="center"
                android:id="@+id/tvCancel"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:text="@string/cancel"
                android:layout_weight="1"
                app:bl_corners_radius="8dp"
                app:bl_solid_color="@color/base_white_10_p"
                style="@font/mulish_bold"/>
            <Space
                android:layout_width="12dp"
                android:layout_height="wrap_content"/>
            <com.noober.background.view.BLTextView
                android:textSize="14sp"
                android:textColor="@color/kids_color_bg"
                android:gravity="center"
                android:id="@+id/tvDelete"
                android:background="@drawable/shape_download_group_button"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:text="@string/kids_delete_confirm_btn"
                android:layout_weight="1"
                style="@font/mulish_bold"/>
        </LinearLayout>
    </com.noober.background.view.BLConstraintLayout>
</FrameLayout>
