<?xml version="1.0" encoding="utf-8"?>
<com.noober.background.view.BLConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    app:bl_corners_radius="6dp"
    app:bl_solid_color="@color/white_10">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivCategoryNameImage"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:maxWidth="120dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.tn.lib.widget.TnTextView
        android:textColor="@color/white_80"
        android:gravity="center"
        android:id="@+id/tvCategoryName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/style_medium_text"/>
</com.noober.background.view.BLConstraintLayout>
