<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/closeAdLayout"
    android:background="@drawable/shape_bg_r12_dark"
    android:paddingLeft="24dp"
    android:paddingTop="24dp"
    android:paddingRight="24dp"
    android:paddingBottom="24dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingHorizontal="24dp"
    android:paddingVertical="24dp"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <TextView
        android:textSize="16sp"
        android:textColor="@color/white"
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ad_close_ad"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/style_text_700"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/ad_white_80"
        android:gravity="center"
        android:id="@+id/tvDesc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/ad_close_desc"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        style="@style/style_text_400"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/ad_white_80"
        android:gravity="center"
        android:id="@+id/tvCloseAd"
        android:background="@drawable/shape_bg_r6_white_10"
        android:layout_width="110dp"
        android:layout_height="36dp"
        android:layout_marginTop="16dp"
        android:text="@string/ad_close_ad_2"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tvResumeAd"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvDesc"
        style="@style/style_text_700"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/gray_dark_00"
        android:gravity="center"
        android:id="@+id/tvResumeAd"
        android:background="@drawable/shape_bg_r6_gradient"
        android:layout_width="110dp"
        android:layout_height="36dp"
        android:text="@string/ad_resume_ad"
        app:layout_constraintBottom_toBottomOf="@+id/tvCloseAd"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvCloseAd"
        app:layout_constraintTop_toTopOf="@+id/tvCloseAd"
        style="@style/style_text_700"/>
</androidx.constraintlayout.widget.ConstraintLayout>
