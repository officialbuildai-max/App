<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.transsion.shorttv_pugc.base.widget.TnTextView
        android:textSize="16sp"
        android:textColor="@color/short_tv_text_01"
        android:id="@+id/sub_operation_appointment_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/short_tv_style_import_text"/>
    <com.transsion.shorttv_pugc.base.widget.OperateScrollableHost
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_6"
        app:layout_constraintTop_toBottomOf="@+id/sub_operation_appointment_title">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/sub_operation_appointment_recycle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </com.transsion.shorttv_pugc.base.widget.OperateScrollableHost>
</androidx.constraintlayout.widget.ConstraintLayout>
