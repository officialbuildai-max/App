<?xml version="1.0" encoding="utf-8"?>
<com.transsion.baseui.widget.RoundedConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cornerRadius="4dp">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/postCover"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/white_80"
        android:gravity="start"
        android:id="@+id/postTitle"
        android:background="@drawable/bg_trending_rank_title"
        android:paddingLeft="4dp"
        android:paddingTop="4dp"
        android:paddingRight="4dp"
        android:paddingBottom="6dp"
        android:layout_width="0dp"
        android:singleLine="true"
        android:textAlignment="viewStart"
        android:paddingHorizontal="4dp"
        app:layout_constraintEnd_toEndOf="@+id/postCover"
        app:layout_constraintStart_toStartOf="@+id/postCover"
        app:layout_constraintTop_toBottomOf="@+id/postCover"
        style="@style/style_medium_text"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/videoPlay"
        android:visibility="gone"
        android:layout_width="@dimen/mini_dp_40"
        android:layout_height="@dimen/mini_dp_40"
        app:layout_constraintBottom_toBottomOf="@+id/postCover"
        app:layout_constraintEnd_toEndOf="@+id/postCover"
        app:layout_constraintStart_toStartOf="@+id/postCover"
        app:layout_constraintTop_toTopOf="@+id/postCover"
        app:srcCompat="@drawable/room_list_video_play_icon"/>
</com.transsion.baseui.widget.RoundedConstraintLayout>
