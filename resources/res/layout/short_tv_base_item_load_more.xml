<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="40dp">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12sp"
        android:textColor="@color/short_tv_white_40"
        android:layout_gravity="center"
        android:id="@+id/tv_no_more"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/short_tv_load_no_more"
        style="@style/short_tv_style_tip_text"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12sp"
        android:textColor="@color/short_tv_white_40"
        android:layout_gravity="center"
        android:id="@+id/tv_err"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/short_tv_load_Load_failed"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12sp"
        android:textColor="@color/short_tv_white_40"
        android:layout_gravity="center"
        android:id="@+id/tv_complete"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/load_view"
        android:layout_width="23dp"
        android:layout_height="23dp"
        android:indeterminateTint="@color/short_tv_main"/>
</FrameLayout>
