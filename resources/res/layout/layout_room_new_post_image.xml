<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.google.android.material.imageview.ShapeableImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/iv_post_cover_2"
        android:layout_width="32dp"
        android:layout_height="22dp"
        android:scaleType="centerCrop"
        android:layout_marginStart="17dp"
        app:shapeAppearance="@style/roundStyle_2"/>
    <com.noober.background.view.BLView
        android:id="@+id/v_post_bg"
        android:layout_width="42dp"
        android:layout_height="28dp"
        android:layout_marginStart="2dp"
        app:bl_corners_radius="2dp"
        app:bl_solid_color="#28292c"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_post_cover_1"
        android:layout_width="42dp"
        android:layout_height="28dp"
        android:scaleType="centerCrop"
        app:shapeAppearance="@style/roundStyle_2"/>
</FrameLayout>
