<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="140dp"
    android:layout_height="154dp">
    <ImageView
        android:id="@+id/widget_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@mipmap/bg_img_widget_small"/>
    <ImageView
        android:background="@drawable/bg_radius16_black80_linear"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_margin="10dp"
        android:src="@mipmap/ic_forground_logo"/>
    <ImageView
        android:id="@+id/widget_search"
        android:paddingLeft="10dp"
        android:paddingTop="12dp"
        android:paddingRight="10dp"
        android:layout_width="36dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_search"
        android:layout_alignParentEnd="true"
        android:paddingHorizontal="10dp"/>
    <ImageView
        android:background="@drawable/hisavana_play"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_centerInParent="true"/>
</RelativeLayout>
