<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/comment_input_layout"
    android:background="@drawable/comment_input_bg"
    android:paddingBottom="6dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="80dp">
    <RelativeLayout
        android:id="@+id/rl_add"
        android:paddingTop="12dp"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="14dp"
            android:textColor="@color/base_color_999999"
            android:id="@+id/tv_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/cl01"
            android:id="@+id/tv_add"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:text="@string/confirm"
            android:paddingStart="30dp"
            android:paddingEnd="16dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rl_add">
        <androidx.appcompat.widget.AppCompatEditText
            android:enabled="true"
            android:textSize="@dimen/text_size_14"
            android:textColor="@color/base_color_333333"
            android:textColorHint="@color/base_color_999999"
            android:gravity="start|top"
            android:autoLink="none"
            android:id="@+id/comment_input_edit_text"
            android:background="@drawable/link_input_edit_bg"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:maxHeight="88dp"
            android:minHeight="35dp"
            android:hint="@string/str_http_header"
            android:paddingStart="12dp"
            android:paddingEnd="77dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>
        <RelativeLayout
            android:id="@+id/rl_clear"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"
            android:visibility="invisible"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true">
            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@mipmap/ic_input_close"
                android:layout_marginEnd="24dp"/>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>
