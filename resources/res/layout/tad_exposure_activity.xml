<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/main_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/layout_title"
        android:background="#ffffff"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimens_48">
        <ImageView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/im_back"
            android:layout_width="@dimen/dimens_24"
            android:layout_height="@dimen/dimens_24"
            android:src="@drawable/hs_ad_login_back_vuid"
            android:scaleType="center"
            android:layout_marginStart="@dimen/dimens_16"/>
        <TextView
            android:textSize="@dimen/dimens_sp_18"
            android:textStyle="bold"
            android:textColor="#ff222222"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:maxWidth="200dp"
            android:lines="1"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/layout_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <FrameLayout
            android:id="@+id/fl_webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/pb_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:progressDrawable="@drawable/hs_ad_pg"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/layout_no_net"
        android:background="#ffffff"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ssp_no_network"
            android:scaleType="center"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#92969e"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_no_network"/>
    </LinearLayout>
</LinearLayout>
