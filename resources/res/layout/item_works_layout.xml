<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivCoverBlur"
        android:layout_width="72dp"
        android:layout_height="96dp"
        android:layout_marginBottom="16dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearance="@style/corner_style_4"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivCover"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@+id/ivCoverBlur"
        app:layout_constraintEnd_toEndOf="@+id/ivCoverBlur"
        app:layout_constraintStart_toStartOf="@+id/ivCoverBlur"
        app:layout_constraintTop_toTopOf="@+id/ivCoverBlur"
        app:shapeAppearance="@style/corner_style_4"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16sp"
        android:textColor="@color/text_01"
        android:ellipsize="end"
        android:id="@+id/tvSubject"
        android:visibility="visible"
        android:layout_width="0dp"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ivCover"
        app:layout_constraintTop_toTopOf="@+id/ivCover"
        style="@style/style_medium_text"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12sp"
        android:textColor="@color/text_03"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/tvSubjectYear"
        android:layout_width="0dp"
        android:layout_marginTop="6dp"
        android:maxLines="2"
        android:drawablePadding="4dp"
        android:textAlignment="viewStart"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tvSubject"
        app:layout_constraintTop_toBottomOf="@+id/tvSubject"
        style="@style/style_regula_bigger_text"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:textColor="@color/yellow_dark_70"
        android:gravity="center"
        android:id="@+id/tvSubjectScore"
        android:layout_height="0dp"
        android:drawablePadding="2dp"
        android:drawableStart="@drawable/ic_category_star"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/llDownload"
        app:layout_constraintStart_toEndOf="@+id/ivCover"
        app:layout_constraintTop_toTopOf="@+id/llDownload"
        style="@style/style_medium_text"/>
    <com.transsnet.downloader.widget.DownloadView
        android:gravity="center_vertical"
        android:id="@+id/llDownload"
        android:background="@drawable/bg_btn_01"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:minWidth="88dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivCover"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
