<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_personal_adapter_item"
    android:layout_width="100dp"
    android:layout_height="126dp">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_cover"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginTop="12dp"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearance="@style/circle_style"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="10sp"
        android:textColor="@color/cl41"
        android:gravity="center"
        android:id="@+id/tv_post_num"
        android:background="@drawable/libui_message_tip"
        android:maxWidth="20dp"
        android:maxHeight="16dp"
        app:layout_constraintEnd_toEndOf="@+id/iv_cover"
        app:layout_constraintTop_toTopOf="@+id/iv_cover"
        style="@style/style_tip_text"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/cl32_ff_p"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_name"
        android:layout_width="84dp"
        android:layout_marginTop="8dp"
        android:maxLines="2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_cover"
        style="@style/style_regular_text"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/cl34"
        android:id="@+id/tv_focus_num"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/style_regular_text"/>
</androidx.constraintlayout.widget.ConstraintLayout>
