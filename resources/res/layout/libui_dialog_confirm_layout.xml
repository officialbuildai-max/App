<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/libui_common_dialog_bg"
    android:paddingBottom="20dp"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:minHeight="140dp">
    <TextView
        android:textColor="@color/text_01"
        android:id="@+id/tv_title"
        android:visibility="visible"
        android:layout_marginTop="28dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/style_title_text"/>
    <TextView
        android:textColor="@color/text_01"
        android:gravity="center"
        android:id="@+id/tv_msg"
        android:layout_marginTop="8dp"
        android:minHeight="40dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        style="@style/style_regula_bigger_text"/>
    <CheckBox
        android:textColor="@color/text_03"
        android:id="@+id/cb"
        android:background="@null"
        android:visibility="gone"
        android:layout_height="16dp"
        android:layout_marginTop="8dp"
        android:button="@null"
        android:includeFontPadding="false"
        android:drawablePadding="4dp"
        android:drawableStart="@drawable/libui_ic_check_selector"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_msg"
        style="@style/style_regula_bigger_text"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_left"
        android:layout_width="0dp"
        android:layout_marginTop="16dp"
        android:minHeight="36dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/tv_right"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cb"
        style="@style/style_sub_btn2_h36"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_right"
        android:layout_width="0dp"
        android:layout_marginTop="16dp"
        android:minHeight="36dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_left"
        app:layout_constraintTop_toBottomOf="@+id/cb"
        style="@style/style_main_btn_h36"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_close"
        android:padding="8dp"
        android:visibility="visible"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@mipmap/libui_ic_close_dialog"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/text_09"/>
</androidx.constraintlayout.widget.ConstraintLayout>
