<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rank_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/mainOpMovieRankImage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/roundStyle_trending"/>
    <ImageView
        android:id="@+id/iv_vip_type"
        android:background="@drawable/bg_vip_subject_icon"
        android:padding="3dp"
        android:visibility="gone"
        android:layout_width="18dp"
        android:layout_height="18dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.transsion.baseui.widget.AlphaTextView
        android:textSize="80sp"
        android:textColor="@color/white_20"
        android:gravity="bottom"
        android:id="@+id/tvRank"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="-20dp"
        android:includeFontPadding="false"
        android:shadowColor="@color/black_60"
        android:shadowDx="-4"
        android:shadowRadius="12"
        android:fontFamily="@font/mulish_bold"
        android:layout_marginEnd="-4dp"
        app:layout_constraintBottom_toBottomOf="@+id/mainOpMovieRankImage"
        app:layout_constraintEnd_toEndOf="@+id/rank_container"
        app:strokeColor="@color/white_60"
        app:strokeWidth="1dp"/>
    <com.tn.lib.view.CornerTextView
        android:id="@+id/main_op_movie_rank_corner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:rectangleShape="true"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/white_80"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/main_op_movie_rank_title"
        android:background="@drawable/bg_trending_rank_title"
        android:paddingLeft="4dp"
        android:paddingTop="4dp"
        android:paddingRight="4dp"
        android:paddingBottom="6dp"
        android:layout_width="0dp"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:paddingHorizontal="4dp"
        app:layout_constraintEnd_toEndOf="@+id/mainOpMovieRankImage"
        app:layout_constraintStart_toStartOf="@+id/mainOpMovieRankImage"
        app:layout_constraintTop_toBottomOf="@+id/mainOpMovieRankImage"
        style="@style/style_regular_text"/>
</androidx.constraintlayout.widget.ConstraintLayout>
