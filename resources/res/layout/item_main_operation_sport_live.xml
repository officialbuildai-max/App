<?xml version="1.0" encoding="utf-8"?>
<com.transsion.baseui.widget.RoundedConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cornerRadius="4dp">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/main_op_sport_live_image"
        android:layout_width="160dp"
        android:layout_height="68dp"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="@color/black_40"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/main_op_sport_live_image"
        app:layout_constraintEnd_toEndOf="@+id/main_op_sport_live_image"
        app:layout_constraintStart_toStartOf="@+id/main_op_sport_live_image"
        app:layout_constraintTop_toTopOf="@+id/main_op_sport_live_image"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_6"
        app:layout_constraintEnd_toEndOf="@+id/main_op_sport_live_image"
        app:layout_constraintStart_toStartOf="@+id/main_op_sport_live_image"
        app:layout_constraintTop_toBottomOf="@+id/main_op_sport_live_status_text">
        <ImageView
            android:id="@+id/main_op_sport_live_vs"
            android:layout_width="28dp"
            android:layout_height="25dp"
            android:src="@mipmap/ic_op_sport_vs"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white_80"/>
        <FrameLayout
            android:id="@+id/main_op_sport_live_team1_container"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/main_op_sport_live_vs"
            app:layout_constraintEnd_toStartOf="@+id/main_op_sport_live_vs"
            app:layout_constraintTop_toTopOf="@+id/main_op_sport_live_vs">
            <com.google.android.material.imageview.ShapeableImageView
                android:layout_gravity="center"
                android:id="@+id/main_op_sport_live_team1_image"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@mipmap/ic_op_live_default"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/circle_style"/>
        </FrameLayout>
        <FrameLayout
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/main_op_sport_live_vs"
            app:layout_constraintStart_toEndOf="@+id/main_op_sport_live_vs"
            app:layout_constraintTop_toTopOf="@+id/main_op_sport_live_vs">
            <com.google.android.material.imageview.ShapeableImageView
                android:layout_gravity="center"
                android:id="@+id/main_op_sport_live_team2_image"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@mipmap/ic_op_live_default"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/circle_style"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/white_80"
        android:gravity="center"
        android:id="@+id/main_op_sport_live_status_text"
        android:background="@drawable/bg_corner_tips_rectangle_2"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_margin="2dp"
        android:text="@string/sport_live_upcoming"
        android:paddingHorizontal="6dp"
        app:layout_constraintStart_toStartOf="@+id/main_op_sport_live_image"
        app:layout_constraintTop_toTopOf="@+id/main_op_sport_live_image"
        style="@style/style_medium_text"/>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@drawable/bg_trending_rank_title"
        android:paddingLeft="4dp"
        android:paddingTop="4dp"
        android:paddingRight="4dp"
        android:paddingBottom="6dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="4dp"
        app:layout_constraintEnd_toEndOf="@+id/main_op_sport_live_image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/main_op_sport_live_image">
        <TextView
            android:textSize="@dimen/text_size_12"
            android:textColor="@color/white_80"
            android:ellipsize="end"
            android:id="@+id/main_op_sport_live_team1"
            android:layout_width="0dp"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_weight="1"
            style="@style/style_regular_text"/>
        <TextView
            android:textSize="@dimen/text_size_12"
            android:textColor="@color/white_80"
            android:ellipsize="end"
            android:paddingLeft="@dimen/dp_4"
            android:paddingRight="@dimen/dp_4"
            android:layout_width="wrap_content"
            android:text="VS"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:paddingHorizontal="@dimen/dp_4"
            style="@style/style_regular_text"/>
        <TextView
            android:textSize="@dimen/text_size_12"
            android:textColor="@color/white_80"
            android:ellipsize="end"
            android:id="@+id/main_op_sport_live_team2"
            android:layout_width="0dp"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_weight="1"
            style="@style/style_regular_text"/>
    </LinearLayout>
</com.transsion.baseui.widget.RoundedConstraintLayout>
