<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.transsion.ad.view.ArcConstraintLayout
        android:id="@+id/ArcViewGroup"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        app:aclArcAreaColor="@color/ad_transparent"
        app:aclArcDepth="36dp"
        app:aclArcMainBackgroundColor="@color/ad_black_40"
        app:aclArcSide="top"
        app:aclArcStrokeColor="@color/ad_white_80"
        app:aclArcStrokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivIndicator"
            android:layout_width="100dp"
            android:layout_height="80dp"
            android:src="@drawable/ad_finger_double_tap_single"
            app:layout_constraintBottom_toTopOf="@+id/tvSwipeTip"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="16sp"
            android:textColor="@color/ad_white"
            android:id="@+id/tvSwipeTip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/ad_swipe_up_or_tap_for_details"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/style_text_600"/>
    </com.transsion.ad.view.ArcConstraintLayout>
</FrameLayout>
