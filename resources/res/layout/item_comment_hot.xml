<?xml version="1.0" encoding="utf-8"?>
<com.noober.background.view.BLConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginRight="12dp"
    android:layout_marginHorizontal="12dp"
    app:bl_corners_radius="6dp"
    app:bl_gradient_angle="0"
    app:bl_gradient_centerColor="@color/brand_new_gradient_center_12"
    app:bl_gradient_endColor="@color/brand_new_gradient_end_12"
    app:bl_gradient_startColor="@color/brand_new_gradient_start_12">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivHotCommentIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:src="@mipmap/ic_post_hot_comment"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.transsion.baseui.widget.GradientTextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:id="@+id/tvHotCommentTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hot Comment"
        android:includeFontPadding="false"
        android:layout_marginStart="2dp"
        app:gradientTvCenterColor="@color/brand_new_gradient_center"
        app:gradientTvEndColor="@color/brand_new_gradient_end"
        app:gradientTvStartColor="@color/brand_new_gradient_start"
        app:layout_constraintBottom_toBottomOf="@+id/ivHotCommentIcon"
        app:layout_constraintStart_toEndOf="@+id/ivHotCommentIcon"
        app:layout_constraintTop_toTopOf="@+id/ivHotCommentIcon"
        style="@style/style_medium_text"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/item_comment_user_avatar"
        android:background="@color/gray_dark_20"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="6dp"
        android:scaleType="centerCrop"
        android:layout_marginStart="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivHotCommentIcon"
        app:shapeAppearanceOverlay="@style/circle_style"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white_60"
        android:ellipsize="end"
        android:id="@+id/item_comment_user_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_marginStart="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/item_comment_data"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/item_comment_user_avatar"
        app:layout_constraintTop_toTopOf="@+id/item_comment_user_avatar"
        style="@style/style_regular_text"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white_60"
        android:ellipsize="end"
        android:id="@+id/item_comment_data"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="4dp"
        app:layout_constraintEnd_toEndOf="@+id/item_comment_content"
        app:layout_constraintStart_toEndOf="@+id/item_comment_user_name"
        app:layout_constraintTop_toTopOf="@+id/item_comment_user_avatar"
        style="@style/style_regular_text"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:textColor="@color/white_80"
        android:gravity="start|center_vertical"
        android:id="@+id/item_comment_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:includeFontPadding="false"
        android:textAlignment="viewStart"
        android:layout_marginEnd="52dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/item_comment_user_name"
        app:layout_constraintTop_toBottomOf="@+id/item_comment_user_name"
        style="@style/style_regular_text"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:enabled="false"
        android:id="@+id/item_comment_like_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/item_comment_user_name"
        app:srcCompat="@drawable/comment_item_like_selector"/>
    <TextView
        android:enabled="false"
        android:textSize="10sp"
        android:textColor="@color/comment_item_like_color"
        android:id="@+id/item_comment_like_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintEnd_toEndOf="@+id/item_comment_like_icon"
        app:layout_constraintStart_toStartOf="@+id/item_comment_like_icon"
        app:layout_constraintTop_toBottomOf="@+id/item_comment_like_icon"/>
    <View
        android:id="@+id/item_comment_like_click_bg"
        android:layout_width="52dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/item_comment_like_count"
        app:layout_constraintEnd_toEndOf="@+id/item_comment_like_count"
        app:layout_constraintStart_toStartOf="@+id/item_comment_like_count"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/comment_cover"
        android:visibility="gone"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="6dp"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="@+id/item_comment_user_name"
        app:layout_constraintTop_toBottomOf="@+id/item_comment_content"
        app:shapeAppearanceOverlay="@style/ImgRoundedStyle_4dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white_60"
        android:id="@+id/item_comment_reply"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/comment_reply"
        android:includeFontPadding="false"
        app:layout_constraintStart_toStartOf="@+id/item_comment_user_name"
        app:layout_constraintTop_toBottomOf="@+id/comment_cover"
        style="@style/style_regular_text"/>
</com.noober.background.view.BLConstraintLayout>
