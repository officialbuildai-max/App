<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/me_vip_entry_container"
        android:background="@drawable/bg_basic_member_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/mini_dp_58">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:layout_marginStart="64dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/color_1B2743"
                android:ellipsize="end"
                android:id="@+id/tv_member_guide_title"
                android:layout_width="194dp"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:fontFamily="@font/mulish_bold"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/color_1B2743"
                android:ellipsize="end"
                android:id="@+id/tv_member_guide_desc"
                android:layout_width="194dp"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:fontFamily="@font/mulish_regular"/>
        </LinearLayout>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_1B2743"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_member_guide_btn"
            android:background="@drawable/bg_btn_me_vip_entry_basic"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="70dp"
            android:minHeight="28dp"
            android:fontFamily="@font/mulish_bold"
            android:layout_marginEnd="@dimen/dp_12"
            android:paddingHorizontal="12dp"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
