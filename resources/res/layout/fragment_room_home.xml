<?xml version="1.0" encoding="utf-8"?>
<com.transsion.baseui.widget.NestedSwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipe_refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.material.appbar.AppBarLayout
            android:orientation="vertical"
            android:id="@+id/appBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/toolbar_layout"
                android:background="@color/bg_01"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:contentScrim="@color/transparent"
                app:layout_scrollFlags="exitUntilCollapsed|scroll">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.transsion.room.widget.CommunityRoomsView
                        android:id="@+id/v_recommend_rooms"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </com.google.android.material.appbar.CollapsingToolbarLayout>
            <FrameLayout
                android:layout_gravity="bottom"
                android:orientation="horizontal"
                android:background="@color/bg_01"
                android:layout_width="match_parent"
                android:layout_height="38dp">
                <net.lucode.hackware.magicindicator.MagicIndicator
                    android:id="@+id/magic_indicator"
                    android:background="@color/bg_01"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="72dp"/>
                <com.noober.background.view.BLView
                    android:layout_gravity="end"
                    android:layout_width="16dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="72dp"
                    app:bl_gradient_angle="0"
                    app:bl_gradient_endColor="@color/bg_01"
                    app:bl_gradient_startColor="@color/transparent"/>
                <com.transsion.baseui.widget.GradientTextView
                    android:textSize="14sp"
                    android:gravity="center"
                    android:layout_gravity="end"
                    android:id="@+id/tv_post"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/film_review_post"
                    android:includeFontPadding="false"
                    android:drawablePadding="4dp"
                    android:drawableStart="@mipmap/icon_room_post"
                    android:paddingHorizontal="12dp"
                    app:gradientTvCenterColor="@color/brand_new_gradient_center"
                    app:gradientTvEndColor="@color/brand_new_gradient_end"
                    app:gradientTvStartColor="@color/brand_new_gradient_start"
                    style="@style/style_import_text"/>
            </FrameLayout>
        </com.google.android.material.appbar.AppBarLayout>
        <com.transsion.baseui.widget.NestedScrollableHost
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/view_pager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </com.transsion.baseui.widget.NestedScrollableHost>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="end|bottom"
            android:id="@+id/iv_publish"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="48dp"
            android:layout_marginEnd="12dp"
            app:srcCompat="@mipmap/ic_room_publish"/>
        <com.tn.lib.view.bubbleview.BubbleTextView
            android:textColor="@color/color_191F2B"
            android:gravity="center"
            android:layout_gravity="end|bottom"
            android:id="@+id/activity_tip"
            android:paddingLeft="@dimen/dp_12"
            android:paddingTop="@dimen/dp_12"
            android:paddingRight="@dimen/dp_12"
            android:paddingBottom="@dimen/dp_12"
            android:visibility="gone"
            android:layout_width="230dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="134dp"
            android:text="@string/room_offline_guide_desc"
            android:includeFontPadding="false"
            android:drawablePadding="8dp"
            android:layout_marginEnd="12dp"
            android:paddingHorizontal="@dimen/dp_12"
            android:paddingVertical="@dimen/dp_12"
            app:angle="8dp"
            app:arrowHeight="10dp"
            app:arrowLocation="bottom"
            app:arrowPosition="196dp"
            app:arrowWidth="16dp"
            app:bubbleColor="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/style_medium_text"/>
        <com.tn.lib.view.RoomCacheAnimationView
            android:layout_gravity="end|bottom"
            android:id="@+id/iv_cache"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginBottom="80dp"
            android:scaleType="centerCrop"
            android:layout_marginEnd="12dp"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</com.transsion.baseui.widget.NestedSwipeRefreshLayout>
