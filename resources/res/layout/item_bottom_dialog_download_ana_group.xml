<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="60dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/selector_download_group_check"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/white_80"
        android:ellipsize="end"
        android:id="@+id/tv_title"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:layout_marginStart="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/tv_size"
        app:layout_constraintEnd_toStartOf="@+id/tv_ep"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/iv_check"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginEnd="16dp"
        style="@style/style_medium_text"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/white_80"
        android:ellipsize="end"
        android:id="@+id/tv_ep"
        android:maxLines="1"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_title"
        app:layout_constraintEnd_toStartOf="@+id/ivPremium"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/tv_title"
        app:layout_constraintTop_toTopOf="@+id/tv_title"
        style="@style/style_medium_text"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="end"
        android:id="@+id/ivPremium"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="12dp"
        android:src="@mipmap/p_v2_premium_3"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_ep"
        app:layout_constraintTop_toTopOf="@+id/tv_title"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/white_60"
        android:ellipsize="end"
        android:id="@+id/tv_size"
        android:layout_marginTop="4dp"
        android:lines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tv_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        app:layout_goneMarginStart="8dp"
        style="@style/style_regular_text"/>
    <View
        android:id="@+id/v_size_line"
        android:background="@color/white_20"
        android:layout_width="1dp"
        android:layout_height="8dp"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_size"
        app:layout_constraintStart_toEndOf="@+id/tv_size"
        app:layout_constraintTop_toTopOf="@+id/tv_size"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/white_60"
        android:ellipsize="end"
        android:id="@+id/tv_time"
        android:lines="1"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_size"
        app:layout_constraintStart_toEndOf="@+id/v_size_line"
        app:layout_constraintTop_toTopOf="@+id/tv_size"
        app:layout_goneMarginStart="8dp"
        style="@style/style_regular_text"/>
</androidx.constraintlayout.widget.ConstraintLayout>
