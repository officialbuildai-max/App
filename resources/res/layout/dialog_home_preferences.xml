<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.noober.background.view.BLConstraintLayout
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:bl_corners_topRadius="12dp"
        app:bl_solid_color="#1c2928"
        app:bl_stroke_width="0.5dp">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_room_cover"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@mipmap/home_img_preferences_dialog_bg"
            android:scaleType="centerCrop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/corner_style_top_12"/>
        <com.tn.lib.widget.TnTextView
            android:textSize="16sp"
            android:textColor="@color/base_color_white"
            android:gravity="center"
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="12dp"
            android:includeFontPadding="false"
            android:textAlignment="center"
            android:layout_marginHorizontal="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/style_import_text"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/white_80"
            android:gravity="center"
            android:id="@+id/tvSubtitle"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="12dp"
            android:textAlignment="center"
            android:layout_marginHorizontal="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle"
            style="@style/style_regular_text"/>
        <ImageView
            android:id="@+id/btnClose"
            android:background="@null"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="12dp"
            android:src="@drawable/ic_close_dialog"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white_60"/>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nsvTags"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:overScrollMode="never"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvSubtitle">
            <HorizontalScrollView
                android:id="@+id/hsvTags"
                android:paddingTop="12dp"
                android:paddingBottom="16dp"
                android:scrollbars="none"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/llRowsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </HorizontalScrollView>
        </androidx.core.widget.NestedScrollView>
        <com.noober.background.view.BLTextView
            android:textSize="14sp"
            android:textColor="@color/gray_dark_00"
            android:gravity="center"
            android:id="@+id/btnConfirm"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="0dp"
            android:text="@string/home_preferences_dialog_confirm"
            android:layout_marginHorizontal="12dp"
            app:bl_corners_radius="6dp"
            app:bl_gradient_angle="0"
            app:bl_gradient_centerColor="@color/brand_new_gradient_center"
            app:bl_gradient_endColor="@color/brand_new_gradient_end"
            app:bl_gradient_startColor="@color/brand_new_gradient_start"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/nsvTags"
            style="@style/style_import_text"/>
    </com.noober.background.view.BLConstraintLayout>
</FrameLayout>
