<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16sp"
        android:textColor="@color/text_01"
        android:ellipsize="end"
        android:gravity="start|bottom"
        android:id="@+id/tvMovieTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:layout_marginStart="12dp"
        android:drawableTint="@color/text_01"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/tvMovieInfo"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginTop="8dp"
        style="@style/style_import_text"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12sp"
        android:textColor="@color/white_60"
        android:id="@+id/tvMovieInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/str_info"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="12dp"
        android:drawableTint="@color/text_01"
        app:drawableEndCompat="@mipmap/movie_detail_ic_arrow_right_white"
        app:layout_constraintBottom_toBottomOf="@+id/tvMovieTitle"
        app:layout_constraintEnd_toStartOf="@+id/v_line"
        app:layout_constraintStart_toEndOf="@+id/tvMovieTitle"
        app:layout_constraintTop_toTopOf="@+id/tvMovieTitle"
        style="@style/style_regular_text"/>
    <View
        android:id="@+id/v_line"
        android:background="@color/line_01"
        android:layout_width="1dp"
        android:layout_height="24dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/tvMovieTitle"
        app:layout_constraintEnd_toStartOf="@+id/ivCollection"
        app:layout_constraintTop_toTopOf="@+id/tvMovieTitle"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivCollection"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/music_collection_0"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvMovieTitle"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/white_60"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tvTag"
        android:layout_width="0dp"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        android:drawablePadding="@dimen/dp_4"
        android:lineSpacingExtra="2dp"
        android:drawableStart="@drawable/ic_tag_edu"
        android:textAlignment="viewStart"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tvMovieTitle"
        app:layout_constraintTop_toBottomOf="@+id/tvMovieTitle"
        style="@style/style_regular_text"/>
    <View
        android:id="@+id/v_detail_hot_zone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="-8dp"
        android:layout_marginBottom="-8dp"
        app:layout_constraintBottom_toBottomOf="@+id/tvTag"
        app:layout_constraintEnd_toStartOf="@+id/v_line"
        app:layout_constraintStart_toStartOf="@+id/tvMovieTitle"
        app:layout_constraintTop_toTopOf="@+id/tvMovieTitle"/>
    <FrameLayout
        android:id="@+id/extension_container"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTag"/>
</androidx.constraintlayout.widget.ConstraintLayout>
