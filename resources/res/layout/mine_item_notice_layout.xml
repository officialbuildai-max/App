<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/bgView"
        android:background="@drawable/bg_color_linear"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:alpha="0.12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/icIV"
        android:layout_width="14dp"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_notice_mine_auto"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.tn.lib.widget.TnTextView
        android:textSize="12sp"
        android:textColor="@color/brand_new_50"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/titleTv"
        android:paddingLeft="6dp"
        android:paddingTop="@dimen/dp_8"
        android:paddingRight="6dp"
        android:paddingBottom="@dimen/dp_8"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:textAlignment="viewStart"
        android:paddingHorizontal="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/arrowIV"
        app:layout_constraintStart_toEndOf="@+id/icIV"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/style_text_600"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/arrowIV"
        android:visibility="gone"
        android:layout_width="@dimen/dp_16"
        android:layout_height="@dimen/dp_16"
        android:src="@drawable/user_setting_arrow"
        android:layout_marginEnd="@dimen/dimens_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/brand_new_50"/>
</androidx.constraintlayout.widget.ConstraintLayout>
