<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_comment_sub_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/item_comment_top_line"
        android:background="@color/dialog_line"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/item_comment_user_name"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/item_comment_user_avatar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="12dp"
        android:scaleType="centerCrop"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/text_size_14"
        android:textColor="@color/white_60"
        android:ellipsize="end"
        android:id="@+id/item_comment_user_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxWidth="200dp"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="52dp"
        app:layout_constraintStart_toEndOf="@+id/item_comment_user_avatar"
        app:layout_constraintTop_toTopOf="@+id/item_comment_user_avatar"
        style="@style/style_regular_text"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/text_size_16"
        android:textColor="@color/white_80"
        android:gravity="start|center_vertical"
        android:id="@+id/item_comment_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:includeFontPadding="false"
        android:textAlignment="viewStart"
        android:layout_marginEnd="52dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/item_comment_user_name"
        app:layout_constraintTop_toBottomOf="@+id/item_comment_user_name"
        style="@style/style_regular_text"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:enabled="false"
        android:id="@+id/item_comment_like_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/item_comment_user_name"
        app:srcCompat="@drawable/comment_item_like_selector"/>
    <TextView
        android:enabled="false"
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/comment_item_like_color"
        android:id="@+id/item_comment_like_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintEnd_toEndOf="@+id/item_comment_like_icon"
        app:layout_constraintStart_toStartOf="@+id/item_comment_like_icon"
        app:layout_constraintTop_toBottomOf="@+id/item_comment_like_icon"/>
    <View
        android:id="@+id/item_comment_like_click_bg"
        android:layout_width="52dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/item_comment_like_count"
        app:layout_constraintEnd_toEndOf="@+id/item_comment_like_count"
        app:layout_constraintStart_toStartOf="@+id/item_comment_like_count"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/comment_cover"
        android:visibility="gone"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="6dp"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="@+id/item_comment_user_name"
        app:layout_constraintTop_toBottomOf="@+id/item_comment_content"
        app:shapeAppearanceOverlay="@style/ImgRoundedStyle_4dp"/>
    <TextView
        android:textSize="@dimen/text_size_14"
        android:textColor="@color/white_60"
        android:ellipsize="end"
        android:id="@+id/item_comment_data"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="50dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/item_comment_user_name"
        app:layout_constraintTop_toTopOf="@+id/item_comment_user_avatar"
        style="@style/style_regular_text"/>
    <TextView
        android:textSize="@dimen/text_size_14"
        android:textColor="@color/white_60"
        android:id="@+id/item_comment_reply"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/comment_reply"
        app:layout_constraintStart_toStartOf="@+id/item_comment_user_name"
        app:layout_constraintTop_toBottomOf="@+id/comment_cover"
        style="@style/style_regular_text"/>
    <View
        android:visibility="invisible"
        android:layout_width="1dp"
        android:layout_height="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/item_comment_reply"/>
</androidx.constraintlayout.widget.ConstraintLayout>
