<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/stateRoot"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivDefaultImage"
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:src="@mipmap/short_tv_ic_no_network"
        android:scaleType="fitCenter"/>
    <TextView
        android:textColor="@color/short_tv_white_60"
        android:gravity="center"
        android:id="@+id/tvDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-20dp"
        android:text="@string/short_tv_net_err"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivDefaultImage"
        style="@style/short_tv_style_regular_text"/>
    <com.noober.background.view.BLTextView
        android:textSize="12sp"
        android:textColor="@color/short_tv_white_80"
        android:gravity="center"
        android:id="@+id/tv_retry"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginTop="12dp"
        android:minWidth="140dp"
        android:text="@string/short_tv_Retry"
        android:paddingHorizontal="12dp"
        app:bl_corners_radius="4dp"
        app:bl_solid_color="@color/short_tv_white_10"
        style="@style/short_tv_style_medium_text"/>
</androidx.appcompat.widget.LinearLayoutCompat>
