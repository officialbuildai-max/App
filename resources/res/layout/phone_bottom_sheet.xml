<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:background="@drawable/bottom_sheet_bg"
        android:paddingBottom="25dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:paddingHorizontal="12dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_back"
                android:padding="4dp"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@mipmap/icon_white_back"
                android:tint="#222222"
                android:layout_centerVertical="true"
                android:contentDescription="@null"
                android:layout_alignParentStart="true"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/gray_light_80"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Top Up"
                android:layout_centerInParent="true"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_close"
                android:padding="4dp"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@mipmap/ic_close"
                android:tint="#222222"
                android:layout_centerVertical="true"
                android:contentDescription="@null"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <View
            android:background="@color/gray_light_10"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingTop="8dp"
            android:paddingRight="16dp"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14sp"
                android:textColor="#888888"
                android:id="@+id/tv_product_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MovieBox"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:id="@+id/tv_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="₦50"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12sp"
                android:textColor="#ff8c00"
                android:id="@+id/tv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="₦50 Airtime + Chance to Win Big Prizes"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_phone_input_container"
            android:background="@drawable/phone_input_light_bg"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="30dp"
            android:layout_marginHorizontal="30dp"
            android:paddingHorizontal="12dp">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_phone_cc"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="16sp"
                    android:textColor="#222222"
                    android:id="@+id/tv_phone_cc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+   "/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_arrow_down"
                    android:tint="#666666"
                    android:contentDescription="@null"
                    android:layout_marginStart="4dp"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <View
                android:background="#e0e0e0"
                android:layout_width="1dp"
                android:layout_height="18dp"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:layout_marginHorizontal="12dp"/>
            <androidx.appcompat.widget.AppCompatEditText
                android:textSize="16sp"
                android:textColor="@color/gray_light_80"
                android:textColorHint="#aaaaaa"
                android:gravity="center_vertical"
                android:id="@+id/et_phone"
                android:background="@null"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:hint="Phone number"
                android:maxLines="1"
                android:layout_weight="1"
                android:inputType="phone"
                style="@style/style_text_400"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_clear"
                android:visibility="gone"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@mipmap/ic_close"
                android:tint="#aaaaaa"
                android:contentDescription="@null"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.AppCompatButton
            android:enabled="false"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/btn_action"
            android:background="@drawable/shape_r8_tint"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="30dp"
            android:text="Pay now"
            android:alpha="0.4"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:backgroundTint="@color/bottom_sheet_btn"
            android:layout_marginHorizontal="30dp"
            style="@style/style_text_600"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
