<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="80dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/v_bg"
        android:background="@drawable/bg_bg_02_4dp"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_progress"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@mipmap/movie_detail_refresh"
        android:indeterminateBehavior="repeat"
        android:layout_marginEnd="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_refresh"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/text_01"
        android:gravity="center"
        android:id="@+id/tv_refresh"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="@string/movie_refresh_new_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_progress"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/style_medium_text"/>
</androidx.constraintlayout.widget.ConstraintLayout>
