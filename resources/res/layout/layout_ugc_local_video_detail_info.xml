<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="8dp"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/style_import_text"/>
    <com.noober.background.view.BLTextView
        android:id="@+id/bgDetails"
        android:layout_width="0dp"
        android:layout_height="28dp"
        android:layout_marginTop="8dp"
        app:bl_corners_radius="26dp"
        app:bl_solid_color="@color/white_10"
        app:layout_constraintEnd_toEndOf="@+id/tvDetails"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivAvatar"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:scaleType="centerCrop"
        android:layout_marginStart="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/bgDetails"
        app:layout_constraintStart_toStartOf="@+id/bgDetails"
        app:layout_constraintTop_toTopOf="@+id/bgDetails"
        app:shapeAppearance="@style/circle_style"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/white"
        android:id="@+id/tvDetails"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/details"
        android:paddingEnd="8dp"
        android:layout_marginStart="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/bgDetails"
        app:layout_constraintStart_toEndOf="@+id/ivAvatar"
        app:layout_constraintTop_toTopOf="@+id/bgDetails"
        style="@style/style_regular_text"/>
    <com.noober.background.view.BLTextView
        android:id="@+id/bgDownload"
        android:layout_width="0dp"
        android:layout_height="28dp"
        android:layout_marginStart="8dp"
        app:bl_corners_radius="26dp"
        app:bl_solid_color="@color/white_10"
        app:layout_constraintEnd_toEndOf="@+id/tvDownload"
        app:layout_constraintStart_toEndOf="@+id/bgDetails"
        app:layout_constraintTop_toTopOf="@+id/bgDetails"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivDownload"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:tint="@color/white"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/bgDownload"
        app:layout_constraintStart_toStartOf="@+id/bgDownload"
        app:layout_constraintTop_toTopOf="@+id/bgDownload"
        app:srcCompat="@drawable/ugc_video_detail_ic_res_post_download"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/white"
        android:id="@+id/tvDownload"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/download_more"
        android:paddingEnd="10dp"
        android:layout_marginStart="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/bgDownload"
        app:layout_constraintEnd_toEndOf="@+id/bgDownload"
        app:layout_constraintStart_toEndOf="@+id/ivDownload"
        app:layout_constraintTop_toTopOf="@+id/bgDownload"
        style="@style/style_regular_text"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/groupDetails"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="bgDetails,ivAvatar,tvDetails"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/groupDownload"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="bgDownload,ivDownload,tvDownload"/>
</androidx.constraintlayout.widget.ConstraintLayout>
