<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.noober.background.view.BLConstraintLayout
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:bl_corners_topRadius="12dp"
        app:bl_solid_color="#1c2928">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivBg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@mipmap/home_img_preferences_dialog_bg"
            android:scaleType="centerCrop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/corner_style_top_12"/>
        <com.tn.lib.widget.TnTextView
            android:textSize="18sp"
            android:textColor="@color/base_color_white"
            android:gravity="center"
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="12dp"
            android:includeFontPadding="false"
            android:textAlignment="center"
            android:layout_marginHorizontal="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/style_import_text"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/white_80"
            android:gravity="center"
            android:id="@+id/tvSubtitle"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="12dp"
            android:textAlignment="center"
            android:layout_marginHorizontal="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle"
            style="@style/style_regular_text"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTags"
            android:clipToPadding="false"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="12dp"
            android:overScrollMode="never"
            android:layout_marginHorizontal="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvSubtitle"/>
        <com.noober.background.view.BLTextView
            android:textSize="16sp"
            android:textColor="@color/gray_dark_00"
            android:gravity="center"
            android:id="@+id/btnConfirm"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="12dp"
            android:text="@string/home_preferences_dialog_confirm"
            android:layout_marginHorizontal="12dp"
            app:bl_corners_radius="6dp"
            app:bl_gradient_angle="0"
            app:bl_gradient_centerColor="@color/brand_new_gradient_center"
            app:bl_gradient_endColor="@color/brand_new_gradient_end"
            app:bl_gradient_startColor="@color/brand_new_gradient_start"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rvTags"
            style="@style/style_import_text"/>
        <com.tn.lib.widget.TnTextView
            android:textSize="16sp"
            android:textColor="@color/white_80"
            android:gravity="center"
            android:id="@+id/btnSkip"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="12dp"
            android:text="@string/home_preferences_dialog_skip"
            android:layout_marginHorizontal="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnConfirm"
            style="@style/style_import_text"/>
    </com.noober.background.view.BLConstraintLayout>
</FrameLayout>
