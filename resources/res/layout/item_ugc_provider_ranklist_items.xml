<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:layout_marginVertical="6dp">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/home_ugc_rankinglist_cover"
        android:layout_width="120dp"
        android:layout_height="68dp"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/roundStyle_4"/>
    <com.tn.lib.view.CornerTextView
        android:id="@+id/home_ugc_rankinglist_corner_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="2dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:rectangleShape="true"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/home_ugc_rankinglist_rank"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/home_ugc_rankinglist_cover"
        app:layout_constraintStart_toStartOf="@+id/home_ugc_rankinglist_cover"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12sp"
        android:textColor="@color/common_white"
        android:id="@+id/home_ugc_rankinglist_text"
        android:paddingLeft="1dp"
        android:paddingRight="1dp"
        android:paddingHorizontal="1dp"
        app:layout_constraintStart_toStartOf="@+id/home_ugc_rankinglist_rank"
        app:layout_constraintTop_toTopOf="@+id/home_ugc_rankinglist_rank"
        style="@style/style_import_text"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/bg_corner_tips_rectangle_2"
        android:paddingLeft="6dp"
        android:paddingTop="2dp"
        android:paddingRight="6dp"
        android:paddingBottom="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="2dp"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/home_ugc_rankinglist_cover"
        app:layout_constraintEnd_toEndOf="@+id/home_ugc_rankinglist_cover">
        <ImageView
            android:id="@+id/home_ugc_ranklist_type_icon"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_tag_movie"
            android:layout_marginEnd="4dp"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/white_80"
            android:id="@+id/home_ugc_ranklist_time_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/style_regular_text"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12sp"
        android:textColor="@color/white_100"
        android:ellipsize="end"
        android:id="@+id/home_ugc_rankinglist_title"
        android:layout_width="0dp"
        android:maxLines="3"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toTopOf="@+id/home_ugc_rankinglist_tag"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/home_ugc_rankinglist_cover"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/style_regular_text"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="11sp"
        android:textColor="@color/white_60"
        android:ellipsize="end"
        android:id="@+id/home_ugc_rankinglist_tag"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/home_ugc_rankinglist_cover"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/home_ugc_rankinglist_cover"
        app:layout_constraintTop_toBottomOf="@+id/home_ugc_rankinglist_title"
        style="@style/style_regular_text"/>
</androidx.constraintlayout.widget.ConstraintLayout>
