<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="20dp">
    <com.noober.background.view.BLTextView
        android:textSize="14sp"
        android:textColor="@color/short_tv_white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_msg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/short_tv_no_network_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/short_tv_style_regular_text"/>
    <com.noober.background.view.BLTextView
        android:textSize="14sp"
        android:textColor="@color/short_tv_white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_retry"
        android:layout_width="144dp"
        android:layout_height="40dp"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="4dp"
        android:text="@string/short_tv_Retry"
        android:layout_marginHorizontal="4dp"
        app:bl_corners_radius="4dp"
        app:bl_solid_color="@color/short_tv_white_10"
        app:layout_constraintEnd_toStartOf="@+id/tv_setting"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_msg"
        style="@style/short_tv_style_regular_text"/>
    <com.noober.background.view.BLTextView
        android:textSize="14sp"
        android:textColor="@color/short_tv_white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_setting"
        android:layout_width="144dp"
        android:layout_height="40dp"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="4dp"
        android:text="@string/short_tv_go_to_setting"
        android:layout_marginHorizontal="4dp"
        app:bl_corners_radius="4dp"
        app:bl_solid_color="@color/short_tv_white_10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_retry"
        app:layout_constraintTop_toBottomOf="@+id/tv_msg"
        style="@style/short_tv_style_regular_text"/>
</androidx.constraintlayout.widget.ConstraintLayout>
