<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/search_result_provider_subject_cover"
        android:layout_width="50dp"
        android:layout_height="70dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearance="@style/roundStyle_4"/>
    <ImageView
        android:id="@+id/iv_vip_type"
        android:background="@drawable/bg_vip_subject_icon"
        android:padding="4dp"
        android:layout_width="16dp"
        android:layout_height="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/search_result_provider_subject_cover"/>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/white_80"
        android:gravity="center"
        android:id="@+id/search_result_provider_subject_corner"
        android:background="@drawable/bg_search_subject_corner"
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/search_result_provider_subject_cover"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/style_medium_text"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/search_result_provider_subject_play"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_result_arrow"
        app:layout_constraintBottom_toBottomOf="@+id/search_result_provider_subject_cover"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/search_result_provider_subject_cover"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/search_result_provider_subject_cover"
        app:layout_constraintEnd_toStartOf="@+id/search_result_provider_subject_play"
        app:layout_constraintStart_toEndOf="@+id/search_result_provider_subject_cover"
        app:layout_constraintTop_toTopOf="@+id/search_result_provider_subject_cover">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/text_size_14"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/search_result_provider_subject_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:textAlignment="viewStart"
            style="@style/style_medium_text"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12sp"
            android:textColor="@color/white_60"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/search_result_provider_subject_brief"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:textAlignment="viewStart"
            style="@style/style_regular_text"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="11sp"
            android:textColor="@color/white_60"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/search_result_provider_subject_website"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/str_play_in_other_website"
            android:maxLines="1"
            android:textAlignment="viewStart"
            style="@style/style_regular_text"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
