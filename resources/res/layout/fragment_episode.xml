<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/llLanguage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@+id/innerTvTitle"
        app:layout_constraintTop_toBottomOf="@+id/innerTvTitle">
        <com.noober.background.view.BLTextView
            android:textSize="12sp"
            android:textColor="@color/white_80"
            android:gravity="center"
            android:id="@+id/tvLanguage"
            android:paddingLeft="8dp"
            android:paddingTop="6dp"
            android:paddingRight="8dp"
            android:paddingBottom="6dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="8dp"
            android:drawablePadding="2dp"
            android:drawableEnd="@mipmap/ic_arrow_down"
            android:layout_marginEnd="8dp"
            android:drawableTint="@color/white_80"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp"
            app:bl_corners_radius="4dp"
            app:bl_stroke_color="@color/white_20"
            app:bl_stroke_width="1dp"
            style="@style/style_medium_text"/>
        <com.noober.background.view.BLTextView
            android:textSize="12sp"
            android:textColor="@color/white_80"
            android:gravity="center"
            android:id="@+id/iv_seasons"
            android:paddingLeft="8dp"
            android:paddingTop="6dp"
            android:paddingRight="8dp"
            android:paddingBottom="6dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="8dp"
            android:drawablePadding="2dp"
            android:drawableEnd="@mipmap/ic_arrow_down"
            android:drawableTint="@color/white_80"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp"
            app:bl_corners_radius="4dp"
            app:bl_stroke_color="@color/white_20"
            app:bl_stroke_width="1dp"
            style="@style/style_medium_text"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text_01"
        android:id="@+id/innerTvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/video_detail_resources"
        android:includeFontPadding="false"
        android:drawablePadding="3dp"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/style_import_text"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/white_60"
        android:id="@+id/innerTvInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/movie_uploaded_by"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:textAlignment="viewStart"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/innerTvTitle"
        app:layout_constraintEnd_toStartOf="@+id/innerTvName"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/innerTvTitle"
        app:layout_constraintTop_toTopOf="@+id/innerTvTitle"
        style="@style/style_regular_text"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12sp"
        android:textColor="@color/white_60"
        android:ellipsize="end"
        android:id="@+id/innerTvName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:textAlignment="viewStart"
        android:layout_marginStart="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/innerTvTitle"
        app:layout_constraintEnd_toStartOf="@+id/innerIcon"
        app:layout_constraintStart_toEndOf="@+id/innerTvInfo"
        app:layout_constraintTop_toTopOf="@+id/innerTvTitle"
        style="@style/style_medium_text"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/innerIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tint="@color/white_60"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/innerTvTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/innerTvName"
        app:layout_constraintTop_toTopOf="@+id/innerTvTitle"
        app:layout_goneMarginEnd="2dp"
        app:srcCompat="@drawable/ic_source_feedback_enter"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/resourceRv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginStart="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_more"
        app:layout_constraintTop_toBottomOf="@+id/llLanguage"
        app:layout_goneMarginStart="12dp"/>
    <com.noober.background.view.BLTextView
        android:textColor="@color/text_01"
        android:gravity="center"
        android:id="@+id/tv_more"
        android:visibility="gone"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:text="@string/all"
        android:layout_marginStart="12dp"
        app:bl_corners_radius="4dp"
        app:bl_solid_color="@color/white_10"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/llLanguage"
        style="@style/style_medium_small_text"/>
</androidx.constraintlayout.widget.ConstraintLayout>
