<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_top"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:paddingEnd="16dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_cancel"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/base_back_black"
            android:paddingStart="16dp"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp">
            <EditText
                android:textSize="@dimen/text_size_14"
                android:textColor="@color/text_01"
                android:textColorHint="@color/base_color_999999"
                android:gravity="center_vertical"
                android:autoLink="none"
                android:id="@+id/comment_input_edit_text"
                android:background="@drawable/bg_search_bg_01"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:maxHeight="88dp"
                android:minHeight="35dp"
                android:hint="@string/search_hint_input"
                android:singleLine="true"
                android:maxLength="200"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:textCursorDrawable="@drawable/cursor_color_p"
                android:paddingStart="32dp"
                android:paddingEnd="34dp"/>
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_search_ic"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_clear"
                android:padding="6dp"
                android:visibility="gone"
                android:layout_width="26dp"
                android:layout_height="match_parent"
                android:src="@drawable/ic_clear"
                android:tint="@color/text_03"
                android:layout_centerVertical="true"
                android:layout_alignEnd="@+id/comment_input_edit_text"/>
        </RelativeLayout>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/brand"
            android:gravity="center"
            android:id="@+id/tv_search"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/search"
            android:paddingStart="8dp"
            android:layout_alignParentEnd="true"/>
    </LinearLayout>
    <View
        android:background="@color/line_01"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_below="@+id/ll_top"/>
    <RelativeLayout
        android:id="@+id/rl_tips"
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:layout_marginTop="16dp"
        android:layout_below="@+id/ll_top"
        android:paddingStart="16dp">
        <TextView
            android:textSize="16dp"
            android:textColor="@color/text_01"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/search_recent"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/text_01"
            android:id="@+id/tv_clear"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/search_clear"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/rl_tips"/>
    <ProgressBar
        android:id="@+id/load_view"
        android:visibility="gone"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_centerInParent="true"
        android:indeterminateTint="@color/main"/>
</RelativeLayout>
