<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="68dp"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/flMemberEquities"
            android:background="@drawable/member_discount_icon_pro_line"
            android:layout_width="31dp"
            android:layout_height="34dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/ivBenefitIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"/>
        </FrameLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12sp"
            android:textColor="#2d3273"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tvBenefitTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="2"
            style="@style/style_text_600"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="#faedc8"
        android:layout_gravity="end"
        android:id="@+id/tvSkuHighlights"
        android:background="@drawable/member_discount_sku_highlights_bg"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:paddingHorizontal="5dp"
        style="@style/style_text_700"/>
</FrameLayout>
