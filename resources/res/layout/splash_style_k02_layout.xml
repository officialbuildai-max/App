<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/ad_hs_splash_bg"
        android:scaleType="centerCrop"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_slice"
            android:background="@drawable/ad_hs_splash_slice"
            android:layout_width="@dimen/hisavana_ad_dimen_302"
            android:layout_height="@dimen/hisavana_ad_dimen_28"
            android:layout_marginTop="-13dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_main_image"/>
        <RelativeLayout
            android:id="@+id/iv_main_image"
            android:background="@color/white"
            android:padding="@dimen/hisavana_ad_dimen_8"
            android:layout_width="196dp"
            android:layout_height="416dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/llRoot"
            android:background="@drawable/ssp_bg_ffffff_8_8_8_8"
            android:paddingBottom="@dimen/dimens_12"
            android:layout_width="@dimen/hisavana_ad_dimen_304"
            android:layout_height="wrap_content"
            android:layout_marginTop="-6dp"
            app:layout_constraintEnd_toEndOf="@+id/iv_slice"
            app:layout_constraintStart_toStartOf="@+id/iv_slice"
            app:layout_constraintTop_toBottomOf="@+id/iv_slice">
            <com.cloud.sdk.commonutil.widget.TranCircleImageView
                android:id="@+id/ivIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                app:borderColorYL="#1a000000"
                app:borderSpaceYL="0.5dp"
                app:borderWidthYL="0.5dp"
                app:bottomLeftRadiusYL="4dp"
                app:bottomRightRadiusYL="4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:topLeftRadiusYL="4dp"
                app:topRightRadiusYL="4dp"/>
            <TextView
                android:textSize="18sp"
                android:textColor="#0f1a2f"
                android:ellipsize="end"
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:lines="1"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="16dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toEndOf="@+id/ivIcon"
                app:layout_constraintTop_toTopOf="@+id/ivIcon"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#787878"
                android:ellipsize="end"
                android:gravity="start"
                android:id="@+id/tvDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:maxLines="1"
                android:lineSpacingExtra="4dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="@+id/tvName"
                app:layout_constraintStart_toStartOf="@+id/tvName"
                app:layout_constraintTop_toBottomOf="@+id/tvName"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/tvBtn"
                android:background="@drawable/ssp_bg_0052e2_4_4_4_4"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginRight="16dp"
                android:text=""
                android:lines="1"
                android:layout_marginHorizontal="16dp"
                android:paddingHorizontal="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ivIcon"
                app:layout_constraintVertical_bias="0"/>
            <com.cloud.hisavana.sdk.api.view.StoreMarkView
                android:id="@+id/ps_mark_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="@dimen/dimens_12"
                app:layout_constraintEnd_toEndOf="@+id/tvBtn"
                app:layout_constraintStart_toStartOf="@+id/tvBtn"
                app:layout_constraintTop_toBottomOf="@+id/tvBtn"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
