<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/push_notification_text"
        android:id="@+id/push_notification_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:paddingEnd="10dp"/>
    <include
        android:id="@+id/content_layout_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        layout="@layout/layout_notification_five_item"/>
    <LinearLayout
        android:id="@+id/content_layout_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">
        <ImageView
            android:id="@+id/imageIv6"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:scaleType="fitCenter"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/imageIv7"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:scaleType="fitCenter"
            android:layout_weight="1"
            android:layout_marginStart="10dp"/>
        <ImageView
            android:id="@+id/imageIv8"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:scaleType="fitCenter"
            android:layout_weight="1"
            android:layout_marginStart="10dp"/>
        <ImageView
            android:id="@+id/imageIv9"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:scaleType="fitCenter"
            android:layout_weight="1"
            android:layout_marginStart="10dp"/>
        <RelativeLayout
            android:id="@+id/moreLayout"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp">
            <ImageView
                android:id="@+id/imageIv10"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:scaleType="fitCenter"/>
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:src="@drawable/ic_push_mask"
                android:scaleType="fitCenter"/>
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:id="@+id/moreIV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/player_more"
                android:includeFontPadding="false"
                android:layout_centerInParent="true"
                android:drawableEnd="@drawable/ic_arrow_right_white_small"
                android:paddingStart="3dp"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
