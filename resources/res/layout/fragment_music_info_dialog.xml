<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_01"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/tv_header_toolbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/movie_detail_more_details"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            style="@style/style_import_text"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/tv_close"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@mipmap/ic_close"
            android:scaleType="center"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <View
        android:background="@color/border"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_header_toolbar"/>
    <androidx.core.widget.NestedScrollView
        android:tag="scrollView"
        android:persistentDrawingCache="animation"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_header_toolbar"
        app:layout_scrollFlags="scroll">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="16sp"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:id="@+id/tvMovieTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="12dp"
                android:layout_marginRight="12dp"
                android:textAlignment="viewStart"
                android:layout_marginHorizontal="12dp"
                app:layout_constraintBottom_toTopOf="@+id/tvTag"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                style="@style/style_import_text"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/white_60"
                android:ellipsize="end"
                android:gravity="start"
                android:id="@+id/tvTag"
                android:layout_width="0dp"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:drawablePadding="@dimen/dp_4"
                android:lineSpacingExtra="2dp"
                android:drawableStart="@drawable/ic_tag_audio"
                android:textAlignment="viewStart"
                android:layout_marginEnd="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/tvMovieTitle"
                app:layout_constraintTop_toBottomOf="@+id/tvMovieTitle"
                style="@style/style_regular_text"/>
            <com.noober.background.view.BLLinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/tv_music_avatar"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="@dimen/dp_12"
                android:layout_marginRight="12dp"
                android:layout_marginHorizontal="12dp"
                app:bl_corners_radius="15dp"
                app:bl_solid_color="@color/white_10"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvTag">
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivAvatar"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="4dp"
                    app:shapeAppearanceOverlay="@style/circle_style"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12sp"
                    android:textColor="@color/white_80"
                    android:ellipsize="end"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tvDes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="12dp"
                    style="@style/style_medium_text"/>
            </com.noober.background.view.BLLinearLayout>
            <com.transsion.moviedetail.view.InfoExtendView
                android:id="@+id/infoExtendView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_music_avatar"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
