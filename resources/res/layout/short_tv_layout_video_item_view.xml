<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/fl_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_cover"
        android:background="@color/short_tv_black"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@+id/fl_container"
        app:layout_constraintEnd_toEndOf="@+id/fl_container"
        app:layout_constraintStart_toStartOf="@+id/fl_container"
        app:layout_constraintTop_toTopOf="@+id/fl_container"/>
    <com.noober.background.view.BLView
        android:id="@+id/up_background"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        app:bl_gradient_angle="270"
        app:bl_gradient_endColor="@color/short_tv_transparent"
        app:bl_gradient_startColor="@color/short_tv_black_50"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.noober.background.view.BLView
        android:id="@+id/bottom_background"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        app:bl_gradient_angle="90"
        app:bl_gradient_endColor="@color/short_tv_transparent"
        app:bl_gradient_startColor="@color/short_tv_black_50"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <ViewStub
        android:id="@+id/vs_locked"
        android:layout="@layout/short_tv_locked_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_play_status"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@mipmap/short_tv_pause"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <Space
        android:id="@+id/progress_guideline"
        android:layout_width="0dp"
        android:layout_height="1.5dp"
        android:layout_marginBottom="7dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toTopOf="@+id/ll_ctr"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_goneMarginBottom="16dp"/>
    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:progressDrawable="@drawable/short_tv_progress"
        app:layout_constraintBottom_toBottomOf="@+id/progress_guideline"
        app:layout_constraintEnd_toEndOf="@+id/progress_guideline"
        app:layout_constraintStart_toStartOf="@+id/progress_guideline"
        style="@android:style/Widget.ProgressBar.Horizontal"/>
    <FrameLayout
        android:id="@+id/flSubtitle"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_name"
        app:layout_constraintEnd_toStartOf="@+id/iv_share"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_goneMarginBottom="158dp">
        <com.avery.subtitle.widget.SimpleSubtitleView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:layout_gravity="center"
            android:id="@+id/vSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <androidx.appcompat.widget.AppCompatSeekBar
        android:layout_gravity="center_vertical"
        android:id="@+id/seek_bar"
        android:background="@color/short_tv_transparent"
        android:focusable="false"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:maxHeight="4dp"
        android:progress="0"
        android:progressDrawable="@drawable/short_tv_layer_seekbar"
        android:minHeight="2dp"
        android:thumb="@drawable/short_tv_shape_seekbar_bar"
        android:thumbOffset="0dp"
        android:layout_weight="1"
        android:splitTrack="false"
        app:layout_constraintBottom_toBottomOf="@+id/progress_guideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/progress_guideline"/>
    <com.transsion.shorttv.ui.widget.ShortTvVideoProgressDragGestureView
        android:id="@+id/v_progress_gesture"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="-20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/progress_bar"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_ctr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14sp"
            android:textColor="@color/short_tv_white"
            android:gravity="center"
            android:id="@+id/tv_speed"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="1x"
            android:includeFontPadding="false"
            android:drawablePadding="4dp"
            android:drawableStart="@drawable/short_tv_ic_speed"
            android:paddingHorizontal="10dp"
            style="@style/short_tv_style_import_text"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14sp"
            android:textColor="@color/short_tv_white"
            android:gravity="center"
            android:id="@+id/tv_resolution"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:includeFontPadding="false"
            android:drawablePadding="4dp"
            android:drawableStart="@mipmap/short_tv_ic_hd"
            android:paddingHorizontal="10dp"
            style="@style/short_tv_style_import_text"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14sp"
            android:textColor="@color/short_tv_selector_language_text"
            android:gravity="center_vertical"
            android:id="@+id/tv_language"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="@string/short_tv_language"
            android:includeFontPadding="false"
            android:drawablePadding="4dp"
            android:drawableStart="@drawable/short_tv_selector_language"
            android:layout_marginEnd="2dp"
            android:paddingHorizontal="10dp"
            style="@style/short_tv_style_import_text"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14sp"
            android:textColor="@color/short_tv_white"
            android:gravity="center_vertical"
            android:id="@+id/tv_audio"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="@string/short_tv_audio"
            android:includeFontPadding="false"
            android:drawablePadding="4dp"
            android:drawableStart="@mipmap/short_tv_ic_audio"
            android:layout_marginEnd="2dp"
            android:paddingHorizontal="10dp"
            style="@style/short_tv_style_import_text"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14sp"
            android:textColor="@color/short_tv_white"
            android:gravity="center_vertical"
            android:id="@+id/tv_subtitles"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="@string/short_tv_subtitles"
            android:includeFontPadding="false"
            android:drawablePadding="4dp"
            android:drawableStart="@drawable/short_tv_ic_language"
            android:layout_marginEnd="2dp"
            android:paddingHorizontal="10dp"
            style="@style/short_tv_style_import_text"/>
        <Space
            android:layout_width="2dp"
            android:layout_height="34dp"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:textColor="@color/short_tv_white"
        android:gravity="center"
        android:id="@+id/tv_progress_des"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:minWidth="150dp"
        app:layout_constraintBottom_toTopOf="@+id/progress_guideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_share"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginBottom="16dp"
        android:scaleType="center"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toTopOf="@+id/progress_guideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@mipmap/short_tv_ic_video_share"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="11sp"
        android:textColor="@color/short_tv_white"
        android:gravity="center_horizontal"
        android:id="@+id/tv_favorite"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:shadowColor="@color/short_tv_black_50"
        android:shadowRadius="3"
        android:layout_marginEnd="12dp"
        app:drawableTopCompat="@drawable/short_tv_selector_short_tv_favorite_big"
        app:layout_constraintBottom_toTopOf="@+id/iv_share"
        app:layout_constraintEnd_toEndOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_download"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginBottom="20dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_favorite"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@mipmap/short_tv_download"/>
    <LinearLayout
        android:gravity="end"
        android:orientation="vertical"
        android:id="@+id/ll_download_guide_bubble"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toTopOf="@+id/iv_download"
        app:layout_constraintEnd_toEndOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14sp"
            android:textColor="@color/short_tv_white"
            android:gravity="center"
            android:id="@+id/tv_download_guide_text"
            android:background="@drawable/short_tv_bg_download_guide_bubble"
            android:paddingLeft="12dp"
            android:paddingTop="8dp"
            android:paddingRight="12dp"
            android:paddingBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/short_tv_download_guide_bubble"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="12dp"
            android:layout_height="6dp"
            android:layout_marginEnd="14dp"
            app:srcCompat="@drawable/short_tv_bg_download_guide_arrow"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:textColor="@color/short_tv_white"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:layout_gravity="start|center_vertical"
        android:id="@+id/tv_episode"
        android:background="@drawable/short_tv_bg_radius_4_color_white"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_marginBottom="24dp"
        android:singleLine="true"
        android:drawablePadding="4dp"
        android:drawableStart="@mipmap/short_tv_ic_episode"
        android:drawableEnd="@mipmap/short_tv_ic_up_hide"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        android:drawableTint="@color/short_tv_white"
        android:paddingHorizontal="8dp"
        app:layout_constraintBottom_toTopOf="@+id/progress_guideline"
        app:layout_constraintEnd_toStartOf="@+id/iv_download"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/short_tv_style_medium_text"/>
    <com.transsion.shorttv.ad.playeroverlayad.ShortTvPlayerOverlayAdContainer
        android:id="@+id/ad_overlay_container_view"
        android:visibility="gone"
        android:layout_width="240dp"
        android:layout_height="135dp"
        android:layout_marginBottom="134dp"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16sp"
        android:textColor="@color/short_tv_white"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/tv_name"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="44dp"
        android:maxLines="2"
        android:textAlignment="viewStart"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="14dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_short_cover"
        app:layout_constraintEnd_toStartOf="@+id/iv_share"
        app:layout_constraintStart_toEndOf="@+id/iv_short_cover"
        app:layout_constraintTop_toTopOf="@+id/iv_short_cover"
        style="@style/short_tv_style_import_text"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_short_cover"
        android:padding="0.5dp"
        android:visibility="visible"
        android:layout_width="30dp"
        android:layout_height="40dp"
        android:layout_marginBottom="8dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toTopOf="@+id/ns_post_des"
        app:layout_constraintEnd_toStartOf="@+id/tv_title"
        app:layout_constraintStart_toStartOf="@+id/progress_guideline"
        app:shapeAppearance="@style/short_tv_roundStyle_2"
        app:strokeColor="@color/short_tv_white_10"
        app:strokeWidth="1dp"/>
    <com.transsion.shorttv.base.widget.NestedScrollableHost
        android:id="@+id/ns_post_des"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/tv_episode"
        app:layout_constraintEnd_toEndOf="@+id/tv_episode"
        app:layout_constraintHeight_max="108dp"
        app:layout_constraintStart_toStartOf="@+id/tv_episode">
        <com.transsion.shorttv.ui.widget.ShortTvImmNestedScrollView
            android:scrollbarThumbVertical="@drawable/short_tv_scrollbar_thumb"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fadeScrollbars="false">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.transsion.shorttv.base.widget.expand.ExpandView
                    android:textSize="12sp"
                    android:textColor="@color/short_tv_white"
                    android:id="@+id/ev_post_des"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_goneMarginBottom="0dp"
                    app:pop_expand_hint_color="@color/short_tv_white"
                    app:pop_hint_text_size="10sp"
                    app:pop_reverse_Lines="2"
                    app:pop_shrink_hint_color="@color/short_tv_white"/>
            </FrameLayout>
        </com.transsion.shorttv.ui.widget.ShortTvImmNestedScrollView>
    </com.transsion.shorttv.base.widget.NestedScrollableHost>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tool_bar"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_back"
            android:padding="12dp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@mipmap/short_tv_icon_white_back"
            android:scaleType="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.transsion.shorttv.base.widget.TnTextView
            android:textColor="@color/short_tv_white"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_back"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_back"
            app:layout_constraintTop_toTopOf="@+id/iv_back"
            style="@style/short_tv_style_title_text"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="iv_share,iv_download,         tv_episode,tv_favorite,tool_bar,tv_name,         iv_short_cover,ns_post_des"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/fm_group_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="iv_download,         tv_episode,tool_bar,tv_name,         iv_short_cover,ns_post_des"/>
    <com.noober.background.view.BLTextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/short_tv_white_60"
        android:gravity="center"
        android:id="@+id/tv_watch_free_countdown"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layout_marginEnd="12dp"
        app:bl_corners_radius="999dp"
        app:bl_solid_color="@color/short_tv_black_60"
        app:bl_stroke_color="@color/short_tv_white_60"
        app:bl_stroke_width="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_pay_lock_hide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tv_name,iv_short_cover,ns_post_des"/>
    <ViewStub
        android:id="@+id/vs_unlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"/>
</merge>
