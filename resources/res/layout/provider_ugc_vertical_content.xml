<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.tn.lib.widget.TnTextView
        android:textSize="@dimen/text_size_14"
        android:textColor="@color/white_100"
        android:ellipsize="end"
        android:id="@+id/tvProviderVerticalTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:paddingStart="@dimen/dimens_12"
        android:paddingEnd="82dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/style_import_text"/>
    <com.tn.lib.widget.TnTextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/white_60"
        android:ellipsize="end"
        android:id="@+id/tvProviderVerticalMore"
        android:maxWidth="68dp"
        android:text="@string/all"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginEnd="@dimen/dimens_12"
        app:drawableEndCompat="@mipmap/ic_arrow_right"
        app:drawableTint="@color/white_60"
        app:layout_constraintBottom_toBottomOf="@+id/tvProviderVerticalTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvProviderVerticalTitle"
        style="@style/style_medium_text"/>
    <com.transsion.baseui.widget.OperateScrollableHost
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/tvProviderVerticalTitle">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvProviderVerticalPost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:layout_marginHorizontal="8dp"/>
    </com.transsion.baseui.widget.OperateScrollableHost>
</androidx.constraintlayout.widget.ConstraintLayout>
