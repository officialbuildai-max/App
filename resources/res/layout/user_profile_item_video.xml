<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="8dp"
    android:layout_width="match_parent"
    android:layout_height="84dp">
    <com.noober.background.view.BLConstraintLayout
        android:id="@+id/cover_container"
        android:layout_width="120dp"
        android:layout_height="68dp"
        app:bl_corners_radius="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/corner_style_4"/>
        <com.noober.background.view.BLConstraintLayout
            android:id="@+id/tag_audio"
            android:paddingLeft="6dp"
            android:paddingTop="2dp"
            android:paddingRight="6dp"
            android:paddingBottom="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            app:bl_corners_radius="2dp"
            app:bl_solid_color="@color/black_80"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.tn.lib.widget.TnTextView
                android:textSize="11sp"
                android:textColor="@color/white_80"
                android:id="@+id/tv_audio_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/style_regular_text"/>
        </com.noober.background.view.BLConstraintLayout>
        <com.noober.background.view.BLLinearLayout
            android:orientation="horizontal"
            android:id="@+id/tag_duration"
            android:paddingLeft="6dp"
            android:paddingTop="2dp"
            android:paddingRight="6dp"
            android:paddingBottom="2dp"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_margin="2dp"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            app:bl_corners_radius="2dp"
            app:bl_solid_color="@color/black_80"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_res_post_type"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="4dp"/>
            <com.tn.lib.widget.TnTextView
                android:textSize="11sp"
                android:textColor="@color/white_80"
                android:id="@+id/tv_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/style_regular_text"/>
        </com.noober.background.view.BLLinearLayout>
    </com.noober.background.view.BLConstraintLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/info_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/cover_container"
        app:layout_constraintTop_toTopOf="parent">
        <com.tn.lib.widget.TnTextView
            android:textColor="@color/white_100"
            android:ellipsize="end"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/style_regular_text"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title">
            <com.tn.lib.widget.TnTextView
                android:textSize="11sp"
                android:textColor="@color/white_50"
                android:ellipsize="end"
                android:id="@+id/tv_views"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/style_regular_text"/>
            <View
                android:id="@+id/separator"
                android:background="@color/white_20"
                android:layout_width="1dp"
                android:layout_height="8dp"
                android:layout_marginBottom="3dp"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/tv_views"
                app:layout_constraintStart_toEndOf="@+id/tv_views"/>
            <com.tn.lib.widget.TnTextView
                android:textSize="11sp"
                android:textColor="@color/white_50"
                android:ellipsize="end"
                android:id="@+id/tv_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/tv_views"
                app:layout_constraintStart_toEndOf="@+id/separator"
                app:layout_constraintTop_toTopOf="@+id/tv_views"
                style="@style/style_regular_text"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
