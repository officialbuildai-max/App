<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:paddingBottom="12dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minHeight="28dp">
    <ProgressBar
        android:layout_gravity="top"
        android:id="@+id/item_comment_sub_more_loading"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="82dp"
        android:indeterminateTint="@color/main"/>
    <LinearLayout
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:id="@+id/item_comment_sub_more_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <View
            android:layout_gravity="center_vertical"
            android:background="@color/text_07"
            android:layout_width="20dp"
            android:layout_height="1dp"
            android:layout_marginStart="55dp"/>
        <TextView
            android:textSize="@dimen/text_size_14"
            android:textColor="#abc2f8"
            android:layout_gravity="center_vertical"
            android:id="@+id/item_comment_sub_more_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            style="@style/style_medium_text"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/comment_sub_more_icon"
            android:layout_marginStart="5dp"
            app:tint="@color/text_07"/>
    </LinearLayout>
</FrameLayout>
