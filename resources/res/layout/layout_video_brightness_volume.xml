<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:id="@+id/ll_bv_root"
    android:background="@drawable/post_detail_shape_bv_bg"
    android:visibility="gone"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="60dp"
    android:layout_centerHorizontal="true"
    android:paddingStart="6dp"
    android:paddingEnd="13dp"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <ImageView
        android:id="@+id/iv_bv_icon"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginEnd="6dp"/>
    <ProgressBar
        android:id="@+id/pb_bv_progress"
        android:layout_width="140dp"
        android:layout_height="2dp"
        android:layout_marginTop="14dp"
        android:maxWidth="180dp"
        android:progressDrawable="@drawable/download_progress_drawable_trans"
        android:minWidth="154dp"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
</LinearLayout>
