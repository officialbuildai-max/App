<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="20dp"/>
    <com.noober.background.view.BLConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:bl_corners_topRadius="12dp"
        app:bl_solid_color="@color/gray_dark_20">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clTitle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            app:layout_constraintTop_toTopOf="parent">
            <com.tn.lib.widget.TnTextView
                android:textColor="@color/base_color_white"
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/home_discover_more"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/btnClose"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/style_import_text"/>
            <ImageView
                android:id="@+id/btnClose"
                android:background="@null"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_close_dialog"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/white_60"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/divider"
            android:background="@color/white_10"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:layout_constraintTop_toBottomOf="@+id/clTitle"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCategories"
            android:padding="12dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/divider"/>
    </com.noober.background.view.BLConstraintLayout>
</FrameLayout>
