<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_constraintTop_toTopOf="@+id/guideline">
    <View
        android:id="@+id/v_space_start"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/v_space_end"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="start|center_vertical"
        android:id="@+id/iv_back"
        android:visibility="invisible"
        android:layout_width="24dp"
        android:layout_height="34dp"
        android:layout_marginTop="12dp"
        android:src="@mipmap/icon_white_back"
        android:scaleType="center"
        app:layout_constraintStart_toEndOf="@+id/v_space_start"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16sp"
        android:textColor="#fff"
        android:ellipsize="end"
        android:layout_gravity="start|center_vertical"
        android:id="@+id/vd_title"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_back"
        app:layout_constraintEnd_toStartOf="@+id/tvDownloadView"
        app:layout_constraintStart_toEndOf="@+id/iv_back"
        app:layout_constraintTop_toTopOf="@+id/iv_back"
        style="@style/style_medium_text"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/yellow_dark_10"
        android:id="@+id/tvUnlockHD"
        android:background="@drawable/p_v2_unlock_hd_bg"
        android:paddingLeft="6dp"
        android:paddingTop="4dp"
        android:paddingRight="6dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Unlock HD"
        android:layout_marginEnd="16dp"
        android:paddingHorizontal="6dp"
        android:paddingVertical="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/tvDownloadView"
        app:layout_constraintEnd_toStartOf="@+id/tvDownloadView"
        app:layout_constraintTop_toTopOf="@+id/tvDownloadView"
        style="@style/style_import_text"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="10sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvDownloadView"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="108dp"
        android:text="@string/View"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:drawableTop="@drawable/ic_ugc_detail_download_view"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_back"
        app:layout_constraintEnd_toStartOf="@+id/tvPro"
        app:layout_constraintTop_toTopOf="@+id/iv_back"
        style="@style/style_regular_text"/>
    <com.transsion.baseui.widget.GradientTextView
        android:textSize="10sp"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvPro"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/long_vod_tv_pro"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:shadowColor="@color/black_30"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="1"
        android:drawableTop="@drawable/ic_long_vod_tv_pro_icon"
        android:textAlignment="center"
        android:layout_marginEnd="20dp"
        app:gradientTvEndColor="@color/yellow_dark_80"
        app:gradientTvStartColor="@color/yellow_dark_90"
        app:layout_constraintBottom_toBottomOf="@+id/tvFeedback"
        app:layout_constraintEnd_toStartOf="@+id/tvFeedback"
        app:layout_constraintTop_toTopOf="@+id/tvFeedback"
        style="@style/style_regular_text"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="10sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvFeedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="108dp"
        android:text="@string/title_help"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:drawableTop="@drawable/ic_ugc_detail_help_icon"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_back"
        app:layout_constraintEnd_toStartOf="@+id/tvSubtitleSetting"
        app:layout_constraintTop_toTopOf="@+id/iv_back"
        style="@style/style_regular_text"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="10sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvSubtitleSetting"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="108dp"
        android:text="@string/long_video_setting"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:drawableTop="@drawable/ic_ugc_detail_setting"
        android:layout_marginEnd="@dimen/dp_12"
        app:layout_constraintBottom_toBottomOf="@+id/iv_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_back"
        style="@style/style_regular_text"/>
</androidx.constraintlayout.widget.ConstraintLayout>
