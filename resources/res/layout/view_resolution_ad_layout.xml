<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.transsion.ad.view.native_ad.NativeWrapperAdView
        android:id="@+id/nativeWrapperAdView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/llBtnH"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/nativeWrapperAdView"
        app:layout_constraintTop_toBottomOf="@+id/nativeWrapperAdView">
        <FrameLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/llChange"
            android:background="@drawable/treasure_bg_4_ffffff_10_shape"
            android:layout_width="44dp"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/ivRefresh"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/treasure_ad_refresh"/>
        </FrameLayout>
        <com.transsion.ad.view.GradientTextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/gray_dark_00"
            android:gravity="center"
            android:id="@+id/tvInstall"
            android:background="@drawable/treasure_bg_4_brand_2_shape"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/treasure_install_to_unlock"
            android:layout_marginStart="8dp"
            app:endColor="#2ff58b"
            app:layout_constraintBottom_toBottomOf="@+id/llChange"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/llChange"
            app:layout_constraintTop_toTopOf="@+id/llChange"
            app:startColor="#1cb7ff"
            style="@style/style_import_text"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/llBtnV"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/nativeWrapperAdView"
        app:layout_constraintTop_toBottomOf="@+id/nativeWrapperAdView">
        <com.transsion.ad.view.GradientTextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/gray_dark_00"
            android:gravity="center"
            android:id="@+id/tvInstallV"
            android:background="@drawable/treasure_bg_4_brand_2_shape"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:text="@string/treasure_install_to_unlock"
            android:layout_marginStart="8dp"
            app:endColor="#2ff58b"
            app:layout_constraintBottom_toBottomOf="@+id/llChange"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/llChange"
            app:layout_constraintTop_toTopOf="@+id/llChange"
            app:startColor="#1cb7ff"
            style="@style/style_import_text"/>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/llChangeV"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            android:layout_marginStart="8dp"
            android:paddingHorizontal="8dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/ivRefreshV"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/treasure_ad_refresh"
                android:layout_marginEnd="4dp"/>
            <com.transsion.ad.view.GradientTextView
                android:textSize="12sp"
                android:textColor="@color/brand_new_gradient_end"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/tvTryMore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/treasure_change"
                app:endColor="#2ff58b"
                app:startColor="#1cb7ff"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
