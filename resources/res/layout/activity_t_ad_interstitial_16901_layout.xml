<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content_layout"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/im_volume"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/hisavana_volume_close"
        android:layout_marginStart="26dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:id="@+id/ad_flag"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="21dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/hs_include_ad_flag"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/main_layout"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:adjustViewBounds="true"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="h,16:9"
        app:layout_constraintTop_toTopOf="parent">
        <com.cloud.sdk.commonutil.widget.TranCircleImageView
            android:id="@+id/iv_main_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/main_layout"
        app:layout_constraintTop_toBottomOf="@+id/im_volume">
        <com.cloud.sdk.commonutil.widget.TranCircleImageView
            android:layout_gravity="center"
            android:id="@+id/ivIcon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="16dp"
            app:bottomLeftRadiusYL="4dp"
            app:bottomRightRadiusYL="4dp"
            app:topLeftRadiusYL="4dp"
            app:topRightRadiusYL="4dp"/>
        <TextView
            android:textSize="20sp"
            android:textColor="#222222"
            android:ellipsize="end"
            android:layout_gravity="center"
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text=""
            android:lines="1"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#787878"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tvSourceSize"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="2dp"
            android:layout_marginRight="24dp"
            android:text=""
            android:singleLine="true"
            android:lineSpacingExtra="4dp"
            android:layout_marginHorizontal="24dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#787878"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tvDescription"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="2dp"
            android:layout_marginRight="24dp"
            android:text=""
            android:maxLines="2"
            android:lineSpacingExtra="4dp"
            android:layout_marginHorizontal="24dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/llRoot"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/main_layout">
        <LinearLayout
            android:id="@+id/ivCancel"
            android:tag="close_button"
            android:background="@drawable/ssp_bg_border_e6e6e6_radius_4"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#cfd1d5"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/close_view"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/interstitial_close"
                android:lines="1"
                android:layout_weight="2"
                android:layout_marginStart="40dp"/>
            <View
                android:layout_gravity="center_vertical"
                android:id="@+id/separator"
                android:background="#d9d9d9"
                android:layout_width="1dp"
                android:layout_height="18dp"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/count_down_view"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="5"
                android:lines="1"
                android:layout_weight="1"
                android:layout_marginEnd="35dp"/>
        </LinearLayout>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tvBtn"
            android:background="@drawable/ssp_bg_0052e2_4_4_4_4"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text=""
            android:lines="1"
            android:layout_weight="1"
            android:layout_marginStart="16dp"/>
    </LinearLayout>
    <com.cloud.hisavana.sdk.api.view.StoreMarkView
        android:id="@+id/ps_mark_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/llRoot"/>
</androidx.constraintlayout.widget.ConstraintLayout>
