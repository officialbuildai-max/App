<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fl_limit"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_limit_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/post_item_header_height"
        android:layout_marginBottom="@dimen/post_item_bottom_height"
        android:scaleType="centerCrop"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tv_limit_tips"
        android:paddingTop="@dimen/post_item_header_height"
        android:paddingBottom="@dimen/post_item_bottom_height"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@string/limit_des"
        android:shadowColor="@color/base_color_80000000"
        android:shadowRadius="3"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
</FrameLayout>
