<?xml version="1.0" encoding="utf-8"?>
<com.noober.background.view.BLConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="8dp"
    app:bl_corners_radius="6dp"
    app:bl_gradient_angle="0"
    app:bl_gradient_centerColor="@color/brand_gradient_center_20"
    app:bl_gradient_endColor="@color/brand_gradient_end_20"
    app:bl_gradient_startColor="@color/brand_gradient_start_20">
    <com.tn.lib.widget.TnTextView
        android:textSize="@dimen/text_size_14"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:drawablePadding="3dp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/style_import_text"/>
    <com.tn.lib.widget.TnTextView
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/white_80"
        android:id="@+id/tvSubTtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/room_recommend_post_subtitle"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:paddingStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/tvTitle"
        app:layout_constraintEnd_toStartOf="@+id/tvMore"
        app:layout_constraintStart_toEndOf="@+id/tvTitle"
        app:layout_constraintTop_toTopOf="@+id/tvTitle"
        style="@style/style_regular_text"/>
    <com.tn.lib.widget.TnTextView
        android:textColor="@color/white_60"
        android:ellipsize="end"
        android:id="@+id/tvMore"
        android:text="@string/explore"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:paddingEnd="8dp"
        app:drawableEndCompat="@mipmap/ic_arrow_right"
        app:drawableTint="@color/white_60"
        app:layout_constraintBottom_toBottomOf="@+id/tvTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvTitle"
        style="@style/style_regular_text"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="5dp"
        android:layout_marginHorizontal="5dp"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"/>
</com.noober.background.view.BLConstraintLayout>
