<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#00000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/cl_card"
        android:background="@drawable/ssp_ad_bubble_card_bg"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="268dp"
        android:layout_height="wrap_content">
        <View
            android:background="@drawable/ssp_ad_bubble_card_bg_gradient"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/tv_cta"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_glow"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:src="@drawable/ssp_ad_bubble_logo_bg"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="@+id/iv_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/iv_icon"/>
        <TextView
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/hs_ad_bubble_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.cloud.sdk.commonutil.widget.TranCircleImageView
            android:id="@+id/iv_icon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="12dp"
            android:scaleType="fitCenter"
            app:bottomLeftRadiusYL="12dp"
            app:bottomRightRadiusYL="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"
            app:topLeftRadiusYL="12dp"
            app:topRightRadiusYL="12dp"/>
        <ImageView
            android:id="@+id/iv_icon_shadow"
            android:layout_width="84dp"
            android:layout_height="6dp"
            android:layout_marginBottom="-3dp"
            android:src="@drawable/hs_ad_bubble_icon_shadow"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="@+id/iv_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#0f1a2f"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_app_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:maxLines="1"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_icon"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#6f7682"
            android:gravity="center"
            android:id="@+id/tv_app_size"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_app_name"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/tv_cta"
            android:background="@drawable/ssp_bg_0052e2_4_4_4_4"
            android:layout_width="220dp"
            android:layout_height="36dp"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_app_size"/>
        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_cta"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#6f7682"
            android:gravity="center"
            android:id="@+id/tv_auto_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:fontFamily="sans-serif"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_cta"/>
        <ImageView
            android:id="@+id/iv_confetti_left"
            android:layout_width="36dp"
            android:layout_height="78dp"
            android:layout_marginTop="-6dp"
            android:src="@drawable/hs_ad_bubble_left"
            android:scaleType="fitXY"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toStartOf="@+id/iv_icon"
            app:layout_constraintTop_toTopOf="@+id/iv_icon"/>
        <ImageView
            android:id="@+id/iv_confetti_right"
            android:layout_width="36dp"
            android:layout_height="78dp"
            android:layout_marginTop="-6dp"
            android:src="@drawable/hs_ad_bubble_right"
            android:scaleType="fitXY"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@+id/iv_icon"
            app:layout_constraintTop_toTopOf="@+id/iv_icon"/>
        <ImageView
            android:id="@+id/iv_close"
            android:padding="10dp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="2dp"
            android:src="@drawable/hs_ad_bubble_close"
            android:layout_marginEnd="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
