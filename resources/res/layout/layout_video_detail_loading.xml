<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_root"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:background="@color/cl45"
        android:layout_width="match_parent"
        android:layout_height="@dimen/post_surface_height"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/vd_iv_back"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="7dp"
        android:src="@mipmap/icon_white_back"
        android:scaleType="center"
        android:layout_marginStart="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:background="@color/cl38_30_p"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/vd_iv_back"
        app:layout_constraintStart_toEndOf="@+id/vd_iv_back"
        app:layout_constraintTop_toTopOf="@+id/vd_iv_back"
        app:shapeAppearance="@style/circle_style"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:background="@color/cl38_30_p"
        android:layout_width="83dp"
        android:layout_height="18dp"
        android:layout_marginStart="34dp"
        app:layout_constraintBottom_toBottomOf="@+id/vd_iv_back"
        app:layout_constraintStart_toEndOf="@+id/vd_iv_back"
        app:layout_constraintTop_toTopOf="@+id/vd_iv_back"
        app:shapeAppearance="@style/circle_style"/>
    <View
        android:id="@+id/vd_bottom_bg"
        android:background="@color/cl38"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="203dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:background="@color/cl37"
        android:layout_width="240dp"
        android:layout_height="18dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/vd_bottom_bg"
        app:shapeAppearance="@style/circle_style"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:background="@color/cl37"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginTop="50dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/vd_bottom_bg"
        app:shapeAppearance="@style/ImgRoundedStyle_4dp"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:background="@color/cl37"
        android:layout_width="72dp"
        android:layout_height="8dp"
        android:layout_marginTop="102dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/vd_bottom_bg"
        app:shapeAppearance="@style/circle_style"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:background="@color/cl37"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="126dp"
        app:layout_constraintTop_toTopOf="@+id/vd_bottom_bg"
        app:shapeAppearance="@style/circle_style"/>
    <ProgressBar
        android:id="@+id/loading_progress"
        android:layout_width="23dp"
        android:layout_height="23dp"
        android:indeterminateTint="@color/cl01"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
