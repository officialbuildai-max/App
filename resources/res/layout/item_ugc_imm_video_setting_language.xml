<?xml version="1.0" encoding="utf-8"?>
<com.noober.background.view.BLFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:layout_marginBottom="12dp"
    app:bl_corners_radius="4dp"
    app:bl_gradient_angle="0"
    app:bl_gradient_centerColor="@color/brand_new_gradient_center_20"
    app:bl_gradient_endColor="@color/brand_new_gradient_end_20"
    app:bl_gradient_startColor="@color/brand_new_gradient_start_20">
    <com.transsion.baseui.widget.GradientTextView
        android:textSize="14sp"
        android:textColor="@color/text_03"
        android:gravity="center"
        android:id="@+id/tvLanguage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:gradientTvCenterColor="@color/brand_new_gradient_center"
        app:gradientTvEndColor="@color/brand_new_gradient_end"
        app:gradientTvStartColor="@color/brand_new_gradient_start"
        style="@style/style_medium_text"/>
</com.noober.background.view.BLFrameLayout>
