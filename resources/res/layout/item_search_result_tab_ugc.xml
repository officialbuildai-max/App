<?xml version="1.0" encoding="utf-8"?>
<com.noober.background.view.BLConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tab_root"
    android:layout_width="wrap_content"
    android:layout_height="28dp"
    android:layout_marginTop="12dp"
    android:layout_marginBottom="6dp"
    android:layout_marginEnd="16dp"
    app:bl_corners_radius="@dimen/dp_16"
    app:bl_selected_solid_color="@color/white_20"
    app:bl_solid_color="@color/white_10"
    app:bl_unSelected_solid_color="@color/white_10">
    <com.transsion.baseui.widget.GradientTextView
        android:textSize="13sp"
        android:textColor="@color/white_80"
        android:gravity="center"
        android:id="@+id/tab_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginHorizontal="12dp"
        app:gradientTvCenterColor="@color/white_80"
        app:gradientTvEndColor="@color/white_80"
        app:gradientTvStartColor="@color/white_80"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/style_regular_text"/>
</com.noober.background.view.BLConstraintLayout>
