<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ProgressBar
        android:id="@+id/progress_1"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:indeterminate="false"
        android:layout_marginVertical="2dp"
        app:layout_constraintEnd_toStartOf="@+id/progress_2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="?android:attr/progressBarStyleHorizontal"/>
    <ProgressBar
        android:id="@+id/progress_2"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:indeterminate="false"
        android:layout_marginEnd="4dp"
        android:layout_marginVertical="2dp"
        app:layout_constraintEnd_toEndOf="@+id/dot_2"
        app:layout_constraintStart_toEndOf="@+id/progress_1"
        app:layout_constraintTop_toTopOf="parent"
        style="?android:attr/progressBarStyleHorizontal"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/dot_1"
        android:layout_width="8dp"
        android:layout_height="8dp"
        app:cardBackgroundColor="@color/double_progress_theme"
        app:cardCornerRadius="4dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="@+id/progress_2"
        app:layout_constraintStart_toStartOf="@+id/progress_1"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/dot_2"
        android:layout_width="8dp"
        android:layout_height="8dp"
        app:cardBackgroundColor="@color/double_progress_theme"
        app:cardCornerRadius="4dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="@+id/title_2"
        app:layout_constraintStart_toStartOf="@+id/title_2"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/gray_light_70"
        android:id="@+id/title_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Download"
        app:layout_constraintEnd_toEndOf="@+id/progress_2"
        app:layout_constraintStart_toStartOf="@+id/progress_1"
        app:layout_constraintTop_toBottomOf="@+id/dot_1"
        style="@style/style_text_400"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/gray_light_70"
        android:id="@+id/title_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Try for 30s"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dot_2"
        style="@style/style_text_400"/>
    <ImageView
        android:id="@+id/point_icon_1"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:src="@mipmap/ic_points"
        app:layout_constraintBottom_toBottomOf="@+id/point_text_1"
        app:layout_constraintEnd_toStartOf="@+id/point_text_1"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/title_1"
        app:layout_constraintTop_toTopOf="@+id/point_text_1"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/task_orange"
        android:id="@+id/point_text_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="+2"
        android:layout_marginStart="2dp"
        app:layout_constraintEnd_toEndOf="@+id/title_1"
        app:layout_constraintStart_toEndOf="@+id/point_icon_1"
        app:layout_constraintTop_toBottomOf="@+id/title_1"
        style="@style/style_text_700"/>
    <ImageView
        android:id="@+id/point_icon_2"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:src="@mipmap/ic_points"
        app:layout_constraintBottom_toBottomOf="@+id/point_text_2"
        app:layout_constraintEnd_toStartOf="@+id/point_text_2"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/title_2"
        app:layout_constraintTop_toTopOf="@+id/point_text_2"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/task_orange"
        android:id="@+id/point_text_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="+3"
        android:layout_marginStart="2dp"
        app:layout_constraintEnd_toEndOf="@+id/title_2"
        app:layout_constraintStart_toEndOf="@+id/point_icon_2"
        app:layout_constraintTop_toBottomOf="@+id/title_2"
        style="@style/style_text_700"/>
</androidx.constraintlayout.widget.ConstraintLayout>
