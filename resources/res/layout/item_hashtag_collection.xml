<?xml version="1.0" encoding="utf-8"?>
<com.noober.background.view.BLConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:bl_corners_radius="4dp">
    <com.noober.background.view.BLConstraintLayout
        android:id="@+id/cover_container"
        android:layout_width="match_parent"
        android:layout_height="149dp"
        app:bl_corners_topRadius="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/corner_style_top_4"/>
        <com.noober.background.view.BLLinearLayout
            android:orientation="horizontal"
            android:id="@+id/tag_video_count"
            android:paddingLeft="6dp"
            android:paddingTop="2dp"
            android:paddingRight="6dp"
            android:paddingBottom="2dp"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_margin="3dp"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            app:bl_corners_radius="2dp"
            app:bl_solid_color="@color/black_80"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_collection_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_tag_movie"/>
            <com.tn.lib.widget.TnTextView
                android:textSize="11sp"
                android:textColor="@color/white_80"
                android:id="@+id/tv_video_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/style_regular_text"/>
        </com.noober.background.view.BLLinearLayout>
    </com.noober.background.view.BLConstraintLayout>
    <com.noober.background.view.BLLinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/info_container"
        android:paddingLeft="4dp"
        android:paddingTop="4dp"
        android:paddingRight="4dp"
        android:paddingBottom="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="4dp"
        app:bl_corners_bottomRadius="4dp"
        app:bl_solid_color="@color/white_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cover_container">
        <com.tn.lib.widget.TnTextView
            android:textColor="@color/white_100"
            android:ellipsize="end"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:lines="2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/style_regular_text"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title">
            <com.tn.lib.widget.TnTextView
                android:textSize="11sp"
                android:textColor="@color/white_50"
                android:ellipsize="end"
                android:id="@+id/tv_views"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/style_regular_text"/>
            <View
                android:id="@+id/separator"
                android:background="@color/white_20"
                android:layout_width="1dp"
                android:layout_height="8dp"
                android:layout_marginBottom="3dp"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/tv_views"
                app:layout_constraintStart_toEndOf="@+id/tv_views"/>
            <com.tn.lib.widget.TnTextView
                android:textSize="11sp"
                android:textColor="@color/white_50"
                android:ellipsize="end"
                android:id="@+id/tv_type"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/tv_views"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/separator"
                app:layout_constraintTop_toTopOf="@+id/tv_views"
                style="@style/style_regular_text"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.noober.background.view.BLLinearLayout>
</com.noober.background.view.BLConstraintLayout>
