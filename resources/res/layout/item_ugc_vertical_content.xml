<?xml version="1.0" encoding="utf-8"?>
<com.noober.background.view.BLConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:bl_corners_radius="6dp"
    app:bl_solid_color="@color/white_6">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivCover"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginBottom="6dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toTopOf="@+id/iv_room_cover"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginTop="0dp"
        app:shapeAppearance="@style/corner_style_top_4"/>
    <com.noober.background.view.BLLinearLayout
        android:orientation="horizontal"
        android:id="@+id/vDurationBg"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:layout_width="0dp"
        android:layout_height="18dp"
        android:layout_margin="2dp"
        android:paddingHorizontal="6dp"
        app:bl_corners_radius="2dp"
        app:bl_solid_color="@color/black_80"
        app:layout_constraintBottom_toBottomOf="@+id/ivCover"
        app:layout_constraintEnd_toEndOf="@+id/ivCover"
        style="@style/style_regular_text">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/ivTypeIcon"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_tag_room"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="@+id/ivCover"
            app:layout_constraintEnd_toStartOf="@+id/tvDuration"
            app:layout_constraintStart_toStartOf="@+id/ivCover"/>
        <com.noober.background.view.BLTextView
            android:textSize="11sp"
            android:textColor="@color/white_80"
            android:gravity="center"
            android:id="@+id/tvDuration"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:includeFontPadding="false"
            android:layout_marginStart="2dp"
            app:layout_constraintBottom_toBottomOf="@+id/ivCover"
            app:layout_constraintEnd_toEndOf="@+id/ivCover"
            style="@style/style_regular_text"/>
    </com.noober.background.view.BLLinearLayout>
    <com.tn.lib.widget.TnTextView
        android:textColor="@color/white_80"
        android:ellipsize="end"
        android:id="@+id/tvTitle"
        android:paddingLeft="4dp"
        android:paddingTop="4dp"
        android:paddingRight="4dp"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:maxLines="2"
        android:paddingHorizontal="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_room_cover"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivCover"
        style="@style/style_regular_text"/>
</com.noober.background.view.BLConstraintLayout>
