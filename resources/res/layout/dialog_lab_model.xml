<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/libui_common_dialog_bg"
    android:paddingTop="20dp"
    android:paddingBottom="20dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:divider="@drawable/shape_lab_divider_line_all"
    android:minWidth="270dp"
    android:showDividers="middle">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="20sp"
        android:textColor="@color/text_01"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="@string/lane"
        style="@style/style_extra_import_text"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:background="@color/btn_bg_01"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="16sp"
            android:textColor="@color/text_02"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="current_cn"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="16sp"
            android:textColor="@color/main"
            android:gravity="center_vertical"
            android:id="@+id/tv_lane_cur"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="cn"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16sp"
        android:textColor="@color/text_02"
        android:gravity="center"
        android:id="@+id/tv_lane_ng"
        android:background="?attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="ng"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16sp"
        android:textColor="@color/text_02"
        android:gravity="center"
        android:id="@+id/tv_lane_ke"
        android:background="?attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="ke"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="15dp"
        android:paddingEnd="15dp">
        <com.transsion.baseui.widget.EditTextWithClear
            android:textSize="16sp"
            android:textColor="@color/text_02"
            android:textColorHint="@color/text_03"
            android:id="@+id/et_custom_cn"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:hint="input custom cn"
            android:layout_weight="1"
            android:layout_marginEnd="15dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="10sp"
            android:textColor="@color/text_02"
            android:gravity="center"
            android:id="@+id/btn_custom_lane"
            android:background="@drawable/libui_sub_btn2_selector"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ok"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16sp"
        android:textColor="@color/main"
        android:gravity="center"
        android:id="@+id/tv_reset"
        android:background="?attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="Reset"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:textColor="@color/text_02"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/btn_close"
        android:background="@drawable/libui_sub_btn2_selector"
        android:layout_width="116dp"
        android:layout_height="30dp"
        android:layout_marginTop="16dp"
        android:text="Cancel"/>
</LinearLayout>
