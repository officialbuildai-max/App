<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">
    <View
        android:id="@+id/channelFlagSkeleton"
        android:background="@drawable/bg_skeleton_drawing_4dp"
        android:layout_width="18dp"
        android:layout_height="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/channelNameSkeleton"
        android:background="@drawable/bg_skeleton_drawing_4dp"
        android:layout_width="0dp"
        android:layout_height="14dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/channelLangSkeleton"
        app:layout_constraintStart_toEndOf="@+id/channelFlagSkeleton"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/channelLangSkeleton"
        android:background="@drawable/bg_skeleton_drawing_4dp"
        android:layout_width="24dp"
        android:layout_height="12dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/channelActionSkeleton"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.noober.background.view.BLView
        android:id="@+id/channelActionSkeleton"
        android:layout_width="32dp"
        android:layout_height="32dp"
        app:bl_corners_radius="16dp"
        app:bl_solid_color="@color/module_05"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/channelDividerSkeleton"
        android:background="@color/white_10"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/channelFlagSkeleton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
