<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="31dp"/>
            <gradient
                android:startColor="#ffffffff"
                android:endColor="#00ffffff"
                android:angle="270"/>
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape>
            <corners android:radius="31dp"/>
            <gradient
                android:startColor="#ffe28f"
                android:endColor="#ffe28f"
                android:angle="0"
                android:centerColor="#faedc8"/>
        </shape>
    </item>
</layer-list>
