<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="999dp"/>
            <gradient
                android:startColor="#ffffff"
                android:endColor="#00ffffff"
                android:angle="270"/>
        </shape>
    </item>
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape>
            <corners android:radius="999dp"/>
            <gradient
                android:startColor="#ffe28f"
                android:endColor="#ffe28f"
                android:angle="0"
                android:centerColor="#faedc8"/>
        </shape>
    </item>
</layer-list>
