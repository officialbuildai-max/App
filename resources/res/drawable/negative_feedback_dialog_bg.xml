<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/gray_dark_10"/>
            <corners
                android:topLeftRadius="12dp"
                android:topRightRadius="12dp"/>
        </shape>
    </item>
    <item
        android:left="-2dp"
        android:right="-2dp"
        android:bottom="-2dp">
        <shape>
            <stroke
                android:width="1dp"
                android:color="@color/base_white_20_p"/>
            <corners
                android:topLeftRadius="12dp"
                android:topRightRadius="12dp"/>
        </shape>
    </item>
</layer-list>
