<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners
                android:topLeftRadius="12dp"
                android:topRightRadius="12dp"
                android:bottomLeftRadius="12dp"
                android:bottomRightRadius="12dp"/>
            <gradient
                android:startColor="#fbeabb"
                android:endColor="#fbeabb"
                android:angle="270"/>
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape>
            <corners
                android:topLeftRadius="12dp"
                android:topRightRadius="12dp"
                android:bottomLeftRadius="12dp"
                android:bottomRightRadius="12dp"/>
            <gradient
                android:startColor="#895732"
                android:endColor="#703f23"
                android:angle="270"/>
        </shape>
    </item>
</layer-list>
