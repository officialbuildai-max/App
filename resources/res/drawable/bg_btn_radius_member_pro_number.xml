<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="12dp"/>
            <gradient
                android:startColor="#fbeabb"
                android:endColor="#fbeabb"
                android:angle="270"
                android:centerColor="#00fbeabb"/>
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape>
            <corners android:radius="12dp"/>
            <gradient
                android:startColor="#703f23"
                android:endColor="#895732"
                android:angle="0"/>
        </shape>
    </item>
</layer-list>
